@DriveFleet.Api_HostAddress = https://localhost:7094

### Register a new client

POST {{DriveFleet.Api_HostAddress}}/api/auth/register
Content-Type: application/json

{
  "firstName": "Carla",
  "lastName": "Ferreira",
  "email": "carla@example.com",
  "phone": "934444444",
  "password": "Example134!"
}

###

### Invalid email

POST {{DriveFleet.Api_HostAddress}}/api/auth/register
Content-Type: application/json

{
  "firstName": "Invalid",
  "lastName": "Email",
  "email": "not-an-email",
  "phone": "911111111",
  "password": "Example123!"
}

###

### Password too short

POST {{DriveFleet.Api_HostAddress}}/api/auth/register
Content-Type: application/json

{
  "firstName": "Short",
  "lastName": "Password",
  "email": "short@example.com",
  "phone": "922222222",
  "password": "123"
}

###

### Missing first name

POST {{DriveFleet.Api_HostAddress}}/api/auth/register
Content-Type: application/json

{
  "firstName": "",
  "lastName": "NoName",
  "email": "noname@example.com",
  "phone": "933333333",
  "password": "Example123!"
}

