<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="DriveFleet.Mobile.Pages.ReservationDetailsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:DriveFleet.Mobile.Models.Reservations"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{StaticResource DriveFleetBackground}">

    <Grid
        RowDefinitions="Auto,*">

        <!-- Header -->
        <Border
            Grid.Row="0"
            StrokeThickness="0"
            Padding="22,24,22,22">

            <Border.Background>
                <LinearGradientBrush
                    StartPoint="0,0"
                    EndPoint="1,1">

                    <GradientStop
                        Color="{StaticResource DriveFleetNavyDark}"
                        Offset="0" />

                    <GradientStop
                        Color="{StaticResource DriveFleetNavy}"
                        Offset="0.7" />

                    <GradientStop
                        Color="#244867"
                        Offset="1" />

                </LinearGradientBrush>
            </Border.Background>

            <Border.StrokeShape>
                <RoundRectangle
                    CornerRadius="0,0,28,28" />
            </Border.StrokeShape>

            <Grid
                ColumnDefinitions="Auto,*"
                ColumnSpacing="14">

                <Button
                    Grid.Column="0"
                    Text="←"
                    WidthRequest="44"
                    HeightRequest="44"
                    Padding="0"
                    CornerRadius="22"
                    BackgroundColor="#1D3852"
                    TextColor="White"
                    FontSize="19"
                    Clicked="OnBackClicked" />

                <VerticalStackLayout
                    Grid.Column="1"
                    VerticalOptions="Center"
                    Spacing="2">

                    <Label
                        Text="Reservation details"
                        TextColor="White"
                        FontSize="24"
                        FontAttributes="Bold" />

                    <Label
                        x:Name="ReservationNumberHeaderLabel"
                        Text="Daily operation"
                        TextColor="#A9BAC9"
                        FontSize="11" />

                </VerticalStackLayout>

            </Grid>

        </Border>

        <Grid Grid.Row="1">

            <!-- Loading -->
            <VerticalStackLayout
                x:Name="LoadingContainer"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                Spacing="12">

                <ActivityIndicator
                    IsRunning="True"
                    WidthRequest="34"
                    HeightRequest="34"
                    Color="{StaticResource DriveFleetNavy}" />

                <Label
                    Text="Loading reservation..."
                    Style="{StaticResource BodyTextStyle}" />

            </VerticalStackLayout>

            <!-- Error -->
            <Border
                x:Name="ErrorContainer"
                IsVisible="False"
                Margin="20"
                MaximumWidthRequest="500"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                Style="{StaticResource CardStyle}">

                <VerticalStackLayout Spacing="14">

                    <Label
                        Text="Unable to load reservation"
                        HorizontalTextAlignment="Center"
                        Style="{StaticResource SectionTitleStyle}" />

                    <Label
                        x:Name="ErrorMessageLabel"
                        HorizontalTextAlignment="Center"
                        Style="{StaticResource BodyTextStyle}" />

                    <Button
                        Text="Try again"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Clicked="OnRetryClicked" />

                </VerticalStackLayout>

            </Border>

            <!-- Details -->
            <ScrollView
                x:Name="ReservationContent"
                IsVisible="False">

                <VerticalStackLayout
                    MaximumWidthRequest="900"
                    HorizontalOptions="Center"
                    Padding="20,22,20,40"
                    Spacing="18">

                    <!-- Reservation identity -->
                    <Border Style="{StaticResource CardStyle}">

                        <VerticalStackLayout Spacing="16">

                            <Grid
                                ColumnDefinitions="*,Auto"
                                ColumnSpacing="12">

                                <VerticalStackLayout
                                    Grid.Column="0"
                                    Spacing="3">

                                    <Label
                                        x:Name="ReservationNumberLabel"
                                        Text="Reservation"
                                        TextColor="{StaticResource DriveFleetTextPrimary}"
                                        FontSize="23"
                                        FontAttributes="Bold" />

                                    <Label
                                        Text="Operational reservation"
                                        Style="{StaticResource CaptionStyle}" />

                                </VerticalStackLayout>

                                <Border
                                    x:Name="StatusBorder"
                                    Grid.Column="1"
                                    VerticalOptions="Start"
                                    StrokeThickness="0"
                                    Padding="11,6"
                                    BackgroundColor="{StaticResource DriveFleetAccentSoft}">

                                    <Border.StrokeShape>
                                        <RoundRectangle
                                            CornerRadius="18" />
                                    </Border.StrokeShape>

                                    <Label
                                        x:Name="StatusLabel"
                                        Text="STATUS"
                                        TextColor="{StaticResource DriveFleetAccent}"
                                        FontSize="9"
                                        FontAttributes="Bold"
                                        CharacterSpacing="0.8" />

                                </Border>

                            </Grid>

                            <BoxView
                                HeightRequest="1"
                                BackgroundColor="{StaticResource DriveFleetBorder}" />

                            <Grid
                                ColumnDefinitions="*,Auto">

                                <Label
                                    Text="Reservation total"
                                    VerticalOptions="Center"
                                    Style="{StaticResource CaptionStyle}" />

                                <Label
                                    x:Name="TotalValueLabel"
                                    Grid.Column="1"
                                    Text="€0.00"
                                    TextColor="{StaticResource DriveFleetNavy}"
                                    FontSize="20"
                                    FontAttributes="Bold" />

                            </Grid>

                        </VerticalStackLayout>

                    </Border>

                    <!-- Customer -->
                    <Border Style="{StaticResource CardStyle}">

                        <VerticalStackLayout Spacing="12">

                            <Label
                                Text="Customer"
                                Style="{StaticResource SectionTitleStyle}" />

                            <BoxView
                                HeightRequest="1"
                                BackgroundColor="{StaticResource DriveFleetBorder}" />

                            <Label
                                x:Name="CustomerNameLabel"
                                TextColor="{StaticResource DriveFleetTextPrimary}"
                                FontSize="15"
                                FontAttributes="Bold" />

                            <Label
                                x:Name="CustomerEmailLabel"
                                Style="{StaticResource BodyTextStyle}" />

                        </VerticalStackLayout>

                    </Border>

                    <!-- Vehicles -->
                    <VerticalStackLayout Spacing="12">

                        <Label
                            Text="Vehicles"
                            Style="{StaticResource SectionTitleStyle}" />

                        <VerticalStackLayout
                            x:Name="VehicleListContainer"
                            Spacing="12"
                            BindableLayout.ItemsSource="{Binding Vehicles}">

                            <BindableLayout.ItemTemplate>

                                <DataTemplate
                                    x:DataType="models:ReservationVehicleModel">

                                    <Border
                                        Style="{StaticResource CardStyle}">

                                        <VerticalStackLayout Spacing="14">

                                            <Grid
                                                ColumnDefinitions="*,Auto">

                                                <VerticalStackLayout
                                                    Grid.Column="0"
                                                    Spacing="3">

                                                    <Label
                                                        Text="{Binding DisplayName}"
                                                        TextColor="{StaticResource DriveFleetTextPrimary}"
                                                        FontSize="17"
                                                        FontAttributes="Bold" />

                                                    <Label
                                                        Text="{Binding LicensePlate}"
                                                        Style="{StaticResource CaptionStyle}" />

                                                </VerticalStackLayout>

                                                <Label
                                                    Grid.Column="1"
                                                    Text="{Binding TotalValue, StringFormat='€{0:F2}'}"
                                                    TextColor="{StaticResource DriveFleetNavy}"
                                                    FontSize="15"
                                                    FontAttributes="Bold" />

                                            </Grid>

                                            <BoxView
                                                HeightRequest="1"
                                                BackgroundColor="{StaticResource DriveFleetBorder}" />

                                            <VerticalStackLayout Spacing="4">

                                                <Label
                                                    Text="RENTAL PERIOD"
                                                    Style="{StaticResource CaptionStyle}" />

                                                <Label
                                                    Text="{Binding PeriodText}"
                                                    TextColor="{StaticResource DriveFleetTextPrimary}"
                                                    FontSize="13"
                                                    FontAttributes="Bold" />

                                            </VerticalStackLayout>

                                            <Grid
                                                ColumnDefinitions="*,*"
                                                ColumnSpacing="12">

                                                <VerticalStackLayout
                                                    Grid.Column="0"
                                                    Spacing="3">

                                                    <Label
                                                        Text="DAILY RATE"
                                                        Style="{StaticResource CaptionStyle}" />

                                                    <Label
                                                        Text="{Binding DailyPrice, StringFormat='€{0:F2}'}"
                                                        TextColor="{StaticResource DriveFleetTextPrimary}"
                                                        FontSize="13"
                                                        FontAttributes="Bold" />

                                                </VerticalStackLayout>

                                                <VerticalStackLayout
                                                    Grid.Column="1"
                                                    Spacing="3">

                                                    <Label
                                                        Text="RENTAL DAYS"
                                                        Style="{StaticResource CaptionStyle}" />

                                                    <Label
                                                        Text="{Binding RentalDays}"
                                                        TextColor="{StaticResource DriveFleetTextPrimary}"
                                                        FontSize="13"
                                                        FontAttributes="Bold" />

                                                </VerticalStackLayout>

                                            </Grid>

                                            <VerticalStackLayout Spacing="4">

                                                <Label
                                                    Text="EXTRAS"
                                                    Style="{StaticResource CaptionStyle}" />

                                                <Label
                                                    Text="{Binding ExtrasSummary}"
                                                    TextColor="{StaticResource DriveFleetTextSecondary}"
                                                    FontSize="12"
                                                    LineBreakMode="WordWrap" />

                                            </VerticalStackLayout>

                                        </VerticalStackLayout>

                                    </Border>

                                </DataTemplate>

                            </BindableLayout.ItemTemplate>

                        </VerticalStackLayout>

                    </VerticalStackLayout>

                    <!-- Workflow -->
                    <Border Style="{StaticResource CardStyle}">

                        <VerticalStackLayout Spacing="14">

                            <VerticalStackLayout Spacing="4">

                                <Label
                                    Text="Reservation workflow"
                                    Style="{StaticResource SectionTitleStyle}" />

                                <Label
                                    Text="Update the reservation as the rental progresses."
                                    Style="{StaticResource BodyTextStyle}" />

                            </VerticalStackLayout>

                            <BoxView
                                HeightRequest="1"
                                BackgroundColor="{StaticResource DriveFleetBorder}" />

                            <Button
                                x:Name="StartReservationButton"
                                Text="Start reservation"
                                IsVisible="False"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Clicked="OnStartReservationClicked" />

                            <Button
                                x:Name="CompleteReservationButton"
                                Text="Complete reservation"
                                IsVisible="False"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Clicked="OnCompleteReservationClicked" />

                            <Label
                                x:Name="ReadOnlyStatusLabel"
                                IsVisible="False"
                                Style="{StaticResource BodyTextStyle}" />

                            <Border
                                x:Name="ActionMessageBorder"
                                IsVisible="False"
                                StrokeThickness="0"
                                Padding="12">

                                <Border.StrokeShape>
                                    <RoundRectangle
                                        CornerRadius="12" />
                                </Border.StrokeShape>

                                <Label
                                    x:Name="ActionMessageLabel"
                                    FontSize="12"
                                    LineBreakMode="WordWrap" />

                            </Border>

                        </VerticalStackLayout>

                    </Border>

                </VerticalStackLayout>

            </ScrollView>

        </Grid>

    </Grid>

</ContentPage>