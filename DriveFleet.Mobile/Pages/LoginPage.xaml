<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="DriveFleet.Mobile.Pages.LoginPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{StaticResource DriveFleetNavyDark}">

    <Grid>

        <!-- Premium dark background -->
        <Grid.Background>
            <LinearGradientBrush
                StartPoint="0,0"
                EndPoint="1,1">

                <GradientStop
                    Color="{StaticResource DriveFleetNavyDark}"
                    Offset="0.0" />

                <GradientStop
                    Color="{StaticResource DriveFleetNavy}"
                    Offset="0.55" />

                <GradientStop
                    Color="#183956"
                    Offset="1.0" />

            </LinearGradientBrush>
        </Grid.Background>

        <!-- Decorative background elements -->
        <Ellipse
            WidthRequest="420"
            HeightRequest="420"
            HorizontalOptions="End"
            VerticalOptions="Start"
            TranslationX="180"
            TranslationY="-190"
            Opacity="0.08"
            Fill="{StaticResource DriveFleetWhite}" />

        <Ellipse
            WidthRequest="320"
            HeightRequest="320"
            HorizontalOptions="Start"
            VerticalOptions="End"
            TranslationX="-170"
            TranslationY="160"
            Opacity="0.05"
            Fill="{StaticResource DriveFleetWhite}" />

        <ScrollView>

            <VerticalStackLayout
                MaximumWidthRequest="470"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                Padding="24,40"
                Spacing="0">

                <!-- Brand -->
                <VerticalStackLayout
                    HorizontalOptions="Center"
                    Margin="0,0,0,28"
                    Spacing="5">

                    <HorizontalStackLayout
                        HorizontalOptions="Center"
                        Spacing="0">

                        <Label
                            Text="Drive"
                            TextColor="{StaticResource DriveFleetWhite}"
                            FontSize="30"
                            FontAttributes="Bold" />

                        <Label
                            Text="Fleet"
                            TextColor="#A9C2D5"
                            FontSize="30"
                            FontAttributes="Bold" />

                    </HorizontalStackLayout>

                    <Label
                        Text="STAFF WORKSPACE"
                        HorizontalTextAlignment="Center"
                        TextColor="#A8B9C9"
                        FontSize="10"
                        FontAttributes="Bold"
                        CharacterSpacing="2.5" />

                </VerticalStackLayout>

                <!-- Login card -->
                <Border
                    BackgroundColor="{StaticResource DriveFleetSurface}"
                    Stroke="{StaticResource DriveFleetBorder}"
                    StrokeThickness="1"
                    Padding="32">

                    <Border.StrokeShape>
                        <RoundRectangle
                            CornerRadius="28" />
                    </Border.StrokeShape>

                    <Border.Shadow>
                        <Shadow
                            Brush="#55000000"
                            Offset="0,12"
                            Radius="28"
                            Opacity="0.25" />
                    </Border.Shadow>

                    <VerticalStackLayout
                        Spacing="0">

                        <!-- Header -->
                        <Border
                            HorizontalOptions="Start"
                            BackgroundColor="{StaticResource DriveFleetAccentSoft}"
                            StrokeThickness="0"
                            Padding="10,5"
                            Margin="0,0,0,18">

                            <Border.StrokeShape>
                                <RoundRectangle
                                    CornerRadius="20" />
                            </Border.StrokeShape>

                            <Label
                                Text="EMPLOYEE ACCESS"
                                TextColor="{StaticResource DriveFleetAccent}"
                                FontSize="10"
                                FontAttributes="Bold"
                                CharacterSpacing="1.4" />

                        </Border>

                        <Label
                            Text="Welcome back"
                            Style="{StaticResource PageTitleStyle}" />

                        <Label
                            Text="Sign in to manage today's fleet operations and reservations."
                            Style="{StaticResource BodyTextStyle}"
                            Margin="0,10,0,28" />

                        <!-- Email -->
                        <Label
                            Text="Email address"
                            Style="{StaticResource FormLabelStyle}"
                            Margin="0,0,0,7" />

                        <Border
                            Style="{StaticResource InputBorderStyle}">

                            <Grid
                                ColumnDefinitions="Auto,*"
                                ColumnSpacing="10">

                                <Label
                                    Grid.Column="0"
                                    Text="✉"
                                    VerticalOptions="Center"
                                    TextColor="{StaticResource DriveFleetTextMuted}"
                                    FontSize="16" />

                                <Entry
                                    x:Name="EmailEntry"
                                    Grid.Column="1"
                                    Style="{StaticResource InputEntryStyle}"
                                    Placeholder="employee@drivefleet.pt"
                                    Keyboard="Email"
                                    ReturnType="Next"
                                    ClearButtonVisibility="WhileEditing" />

                            </Grid>

                        </Border>

                        <!-- Password -->
                        <Label
                            Text="Password"
                            Style="{StaticResource FormLabelStyle}"
                            Margin="0,18,0,7" />

                        <Border
                            Style="{StaticResource InputBorderStyle}">

                            <Grid
                                ColumnDefinitions="Auto,*"
                                ColumnSpacing="10">

                                <Label
                                    Grid.Column="0"
                                    Text="●"
                                    VerticalOptions="Center"
                                    TextColor="{StaticResource DriveFleetTextMuted}"
                                    FontSize="12" />

                                <Entry
                                    x:Name="PasswordEntry"
                                    Grid.Column="1"
                                    Style="{StaticResource InputEntryStyle}"
                                    Placeholder="Enter your password"
                                    IsPassword="True"
                                    ReturnType="Go" />

                            </Grid>

                        </Border>

                        <!-- Error area -->
                        <Border
                            x:Name="ErrorBorder"
                            IsVisible="False"
                            BackgroundColor="{StaticResource DriveFleetDangerSoft}"
                            StrokeThickness="0"
                            Padding="12"
                            Margin="0,16,0,0">

                            <Border.StrokeShape>
                                <RoundRectangle
                                    CornerRadius="12" />
                            </Border.StrokeShape>

                            <Label
                                x:Name="ErrorLabel"
                                TextColor="{StaticResource DriveFleetDanger}"
                                FontSize="12"
                                LineBreakMode="WordWrap" />

                        </Border>

                        <!-- Login -->
                        <Button
                            x:Name="SignInButton"
                            Text="Sign in"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Margin="0,24,0,0"
                            Clicked="OnSignInClicked" />

                        <!-- Loading -->
                        <HorizontalStackLayout
                            x:Name="LoadingContainer"
                            IsVisible="False"
                            HorizontalOptions="Center"
                            Margin="0,16,0,0"
                            Spacing="8">

                            <ActivityIndicator
                                IsRunning="True"
                                WidthRequest="18"
                                HeightRequest="18"
                                Color="{StaticResource DriveFleetNavy}" />

                            <Label
                                Text="Signing in..."
                                VerticalOptions="Center"
                                Style="{StaticResource CaptionStyle}" />

                        </HorizontalStackLayout>

                        <!-- Footer -->
                        <BoxView
                            HeightRequest="1"
                            BackgroundColor="{StaticResource DriveFleetBorder}"
                            Margin="0,28,0,18" />

                        <HorizontalStackLayout
                            HorizontalOptions="Center"
                            Spacing="6">

                            <Label
                                Text="Secure employee access"
                                Style="{StaticResource CaptionStyle}" />

                            <Label
                                Text="•"
                                TextColor="{StaticResource DriveFleetTextMuted}"
                                FontSize="11" />

                            <Label
                                Text="DriveFleet"
                                TextColor="{StaticResource DriveFleetNavy}"
                                FontSize="12"
                                FontAttributes="Bold" />

                        </HorizontalStackLayout>

                    </VerticalStackLayout>

                </Border>

                <!-- Bottom information -->
                <Label
                    Text="Fleet operations · Reservations · Vehicle management"
                    HorizontalTextAlignment="Center"
                    TextColor="#91A6B8"
                    FontSize="11"
                    Margin="0,22,0,0" />

            </VerticalStackLayout>

        </ScrollView>

    </Grid>

</ContentPage>