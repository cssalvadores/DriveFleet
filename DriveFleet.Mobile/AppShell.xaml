<?xml version="1.0" encoding="UTF-8" ?>

<Shell
    x:Class="DriveFleet.Mobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:DriveFleet.Mobile.Pages"
    Title="DriveFleet"
    FlyoutBehavior="Disabled">

    <ShellContent
        Title="Login"
        Route="LoginPage"
        ContentTemplate="{DataTemplate pages:LoginPage}" />

    <ShellContent
        Title="Employee Home"
        Route="EmployeeHomePage"
        ContentTemplate="{DataTemplate pages:EmployeeHomePage}" />

    <ShellContent
        Title="Vehicles"
        Route="VehiclesPage"
        ContentTemplate="{DataTemplate pages:VehiclesPage}" />

    <ShellContent
        Title="Vehicle Details"
        Route="VehicleDetailsPage"
        ContentTemplate="{DataTemplate pages:VehicleDetailsPage}" />

    <ShellContent
        Title="Today's Reservations"
        Route="TodayReservationsPage"
        ContentTemplate="{DataTemplate pages:TodayReservationsPage}" />

    <ShellContent
        Title="Reservation Details"
        Route="ReservationDetailsPage"
        ContentTemplate="{DataTemplate pages:ReservationDetailsPage}" />

</Shell>
