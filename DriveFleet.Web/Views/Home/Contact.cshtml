@{
    ViewData["Title"] = "Contact";
}

<section class="drivefleet-contact">

    <div class="container">

        <div class="drivefleet-contact-header">

            <div class="drivefleet-contact-eyebrow">
                CONTACT
            </div>

            <h1 class="drivefleet-contact-title">
                We’re here to help.
            </h1>

            <p class="drivefleet-contact-lead">
                Need help with a reservation, a vehicle
                or your DriveFleet account?
                Our team is available to assist you.
            </p>

        </div>

        <div class="row g-4 justify-content-center">

            <div class="col-lg-7">

                <div class="drivefleet-contact-card">

                    <div class="drivefleet-contact-card-header">

                        <div>
                            <span class="drivefleet-contact-card-kicker">
                                CUSTOMER SUPPORT
                            </span>

                            <h2>
                                Talk to our team.
                            </h2>
                        </div>

                        <div class="drivefleet-contact-status">

                            <span class="drivefleet-contact-status-dot">
                            </span>

                            Available
                        </div>

                    </div>

                    <p class="drivefleet-contact-card-description">
                        Contact us for assistance with bookings,
                        vehicle information or account-related questions.
                    </p>

                    <div class="drivefleet-contact-details">

                        <div class="drivefleet-contact-item">

                            <div class="drivefleet-contact-icon">

                                <svg viewBox="0 0 24 24"
                                     aria-hidden="true">
                                    <path d="M4 5h16a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2Zm8 7 8-5H4l8 5Zm0 2.35L4 9.35V17h16V9.35l-8 5Z" />
                                </svg>

                            </div>

                            <div class="drivefleet-contact-item-content">

                                <span class="drivefleet-contact-label">
                                    Email
                                </span>

                                <a href="mailto:support@drivefleet.pt"
                                   class="drivefleet-contact-value">
                                    support@drivefleet.pt
                                </a>

                                <span class="drivefleet-contact-helper">
                                    Send us your question at any time.
                                </span>

                            </div>

                        </div>

                        <div class="drivefleet-contact-item">

                            <div class="drivefleet-contact-icon">

                                <svg viewBox="0 0 24 24"
                                     aria-hidden="true">
                                    <path d="M6.62 10.79a15.46 15.46 0 0 0 6.59 6.59l2.2-2.2a1 1 0 0 1 1.02-.24 11.36 11.36 0 0 0 3.57.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1C10.61 21 3 13.39 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1 11.36 11.36 0 0 0 .57 3.57 1 1 0 0 1-.25 1.02l-2.2 2.2Z" />
                                </svg>

                            </div>

                            <div class="drivefleet-contact-item-content">

                                <span class="drivefleet-contact-label">
                                    Phone
                                </span>

                                <a href="tel:+351210987654"
                                   class="drivefleet-contact-value">
                                    +351 210 000 000
                                </a>

                                <span class="drivefleet-contact-helper">
                                    Monday to Friday · 09:00 — 18:00
                                </span>

                            </div>

                        </div>

                    </div>

                    <div class="drivefleet-contact-actions">

                        <a href="mailto:support@drivefleet.pt"
                           class="drivefleet-contact-primary-action">

                            <svg viewBox="0 0 24 24"
                                 aria-hidden="true">
                                <path d="M4 5h16a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2Zm8 7 8-5H4l8 5Zm0 2.35L4 9.35V17h16V9.35l-8 5Z" />
                            </svg>

                            Email us
                        </a>

                        <a href="tel:+351210987654"
                           class="drivefleet-contact-secondary-action">

                            <svg viewBox="0 0 24 24"
                                 aria-hidden="true">
                                <path d="M6.62 10.79a15.46 15.46 0 0 0 6.59 6.59l2.2-2.2a1 1 0 0 1 1.02-.24 11.36 11.36 0 0 0 3.57.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1C10.61 21 3 13.39 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1 11.36 11.36 0 0 0 .57 3.57 1 1 0 0 1-.25 1.02l-2.2 2.2Z" />
                            </svg>

                            Call us
                        </a>

                    </div>

                </div>

            </div>

            <div class="col-lg-5">

                <aside class="drivefleet-support-card">

                    <span class="drivefleet-contact-card-kicker">
                        BEFORE YOU CONTACT US
                    </span>

                    <h2>
                        Get help faster.
                    </h2>

                    <p>
                        If your question is related to an existing
                        booking, include your reservation number
                        when contacting our team.
                    </p>

                    <div class="drivefleet-support-divider">
                    </div>

                    <span class="drivefleet-support-heading">
                        We can help with
                    </span>

                    <ul class="drivefleet-support-list">

                        <li>
                            Reservation assistance
                        </li>

                        <li>
                            Vehicle availability
                        </li>

                        <li>
                            Account and profile support
                        </li>

                        <li>
                            General DriveFleet enquiries
                        </li>

                    </ul>

                    <div class="drivefleet-support-note">

                        <span>
                            Typical response time
                        </span>

                        <strong>
                            During business hours
                        </strong>

                    </div>

                </aside>

            </div>

        </div>

    </div>

</section>