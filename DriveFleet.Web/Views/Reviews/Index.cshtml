@model IReadOnlyList<DriveFleet.Web.Models.Reviews.AdminReviewViewModel>

@{
    ViewData["Title"] = "Review moderation";

    var totalReviews =
        Model.Count;

    var visibleReviews =
        Model.Count(review => review.IsVisible);

    var hiddenReviews =
        Model.Count(review => !review.IsVisible);
}

<div class="container py-4"
     style="max-width: 1100px;">

    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
        <div>
            <h1 class="h3 mb-1">
                Review moderation
            </h1>

            <p class="text-muted mb-0">
                Manage customer reviews published in the vehicle catalog.
            </p>
        </div>

        <a asp-controller="Vehicles"
           asp-action="Index"
           class="btn btn-outline-secondary btn-sm">
            View vehicle catalog
        </a>
    </div>

    @if (TempData["ReviewSuccess"] is string successMessage)
    {
        <div class="alert alert-success"
             role="alert">
            @successMessage
        </div>
    }

    @if (TempData["ReviewError"] is string errorMessage)
    {
        <div class="alert alert-danger"
             role="alert">
            @errorMessage
        </div>
    }

    <div class="row g-3 mb-4">
        <div class="col-12 col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small mb-1">
                        Total reviews
                    </div>

                    <div class="fs-3 fw-semibold">
                        @totalReviews
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small mb-1">
                        Visible
                    </div>

                    <div class="fs-3 fw-semibold">
                        @visibleReviews
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small mb-1">
                        Hidden
                    </div>

                    <div class="fs-3 fw-semibold">
                        @hiddenReviews
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (Model.Count == 0)
    {
        <div class="card shadow-sm">
            <div class="card-body text-center py-5">
                <h2 class="h5 mb-2">
                    No reviews available
                </h2>

                <p class="text-muted mb-0">
                    Customer reviews will appear here once they are submitted.
                </p>
            </div>
        </div>
    }
    else
    {
        <div class="d-flex flex-column gap-3">
            @foreach (var review in Model)
            {
                <div class="card shadow-sm">
                    <div class="card-body">

                        <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">

                            <div class="flex-grow-1">

                                <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                                    <div class="fw-semibold"
                                         aria-label="@review.Stars out of 5 stars">
                                        @for (var star = 1; star <= 5; star++)
                                        {
                                            if (star <= review.Stars)
                                            {
                                                <span aria-hidden="true">
                                                    ★
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="text-muted"
                                                      aria-hidden="true">
                                                    ☆
                                                </span>
                                            }
                                        }
                                    </div>

                                    @if (review.IsVisible)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle">
                                            Visible
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">
                                            Hidden
                                        </span>
                                    }
                                </div>

                                @if (string.IsNullOrWhiteSpace(review.Comment))
                                {
                                    <p class="text-muted fst-italic mb-3">
                                        No written comment.
                                    </p>
                                }
                                else
                                {
                                    <p class="mb-3"
                                       style="max-width: 780px; white-space: pre-line;">
                                        @review.Comment
                                    </p>
                                }

                                <div class="d-flex flex-wrap gap-3 small text-muted">
                                    <span>
                                        Review #@review.ReviewId
                                    </span>

                                    <span>
                                        Vehicle #@review.VehicleId
                                    </span>

                                    <span>
                                        Reservation vehicle #@review.ReservationVehicleId
                                    </span>

                                    <span>
                                        @review.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                    </span>
                                </div>

                                <div class="mt-3">
                                    <a asp-controller="Vehicles"
                                       asp-action="Details"
                                       asp-route-vehicleId="@review.VehicleId"
                                       class="btn btn-sm btn-outline-secondary">
                                        Vehicle details
                                    </a>
                                </div>
                            </div>

                            <div class="d-flex flex-column flex-sm-row gap-2 ms-sm-auto">

                                <form asp-controller="Reviews"
                                      asp-action="SetVisibility"
                                      asp-route-reviewId="@review.ReviewId"
                                      method="post">

                                    @Html.AntiForgeryToken()

                                    @if (review.IsVisible)
                                    {
                                        <button type="submit"
                                                name="isVisible"
                                                value="false"
                                                class="btn btn-sm btn-outline-secondary">
                                            Hide
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="submit"
                                                name="isVisible"
                                                value="true"
                                                class="btn btn-sm btn-outline-primary">
                                            Show
                                        </button>
                                    }
                                </form>

                                <form asp-controller="Reviews"
                                      asp-action="Delete"
                                      asp-route-reviewId="@review.ReviewId"
                                      method="post"
                                      onsubmit="return confirm('Are you sure you want to permanently delete this review?');">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="btn btn-sm btn-outline-danger">
                                        Delete
                                    </button>
                                </form>

                            </div>

                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
