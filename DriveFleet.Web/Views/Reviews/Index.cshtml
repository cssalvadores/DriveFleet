@model IReadOnlyList<DriveFleet.Web.Models.Reviews.AdminReviewViewModel>

@using System.Globalization

@{
    ViewData["Title"] = "Review moderation";

    var englishCulture =
        CultureInfo.GetCultureInfo("en-GB");

    var totalReviews =
        Model.Count;

    var visibleReviews =
        Model.Count(review =>
            review.IsVisible);

    var hiddenReviews =
        Model.Count(review =>
            !review.IsVisible);

    var averageRating =
        totalReviews == 0
            ? 0
            : Model.Average(review =>
                review.Stars);

    var fiveStarReviews =
        Model.Count(review =>
            review.Stars == 5);

    var orderedReviews =
        Model
            .OrderByDescending(review =>
                review.CreatedAt)
            .ToList();
}

<link rel="stylesheet"
      href="~/css/reviews.css"
      asp-append-version="true" />

<section class="review-moderation-page">

    <!-- Back navigation -->
    <div class="review-moderation-back">

        <a asp-controller="Dashboard"
           asp-action="Index"
           class="review-moderation-back__link">

            <span aria-hidden="true">
                ←
            </span>

            <span>
                Back to dashboard
            </span>

        </a>

    </div>

    <!-- Hero -->
    <header class="review-moderation-hero">

        <div class="review-moderation-hero__content">

            <div>

                <span class="review-moderation-eyebrow">
                    DRIVEFLEET BACKOFFICE
                </span>

                <h1>
                    Review moderation
                </h1>

                <p>
                    Monitor customer feedback and control which
                    reviews are publicly visible in the vehicle catalog.
                </p>

            </div>

            <a asp-controller="Vehicles"
               asp-action="Index"
               class="review-moderation-hero__action">

                <span class="review-moderation-hero__action-icon"
                      aria-hidden="true">
                    ↗
                </span>

                <span>
                    View vehicle catalog
                </span>

            </a>

        </div>

        <div class="review-moderation-hero__footer">

            <div>

                <span class="review-moderation-live-dot">
                </span>

                <span>
                    Administrative moderation
                </span>

            </div>

            <div>
                Customer feedback management
            </div>

        </div>

    </header>

    <!-- Feedback -->
    @if (TempData["ReviewSuccess"] is string successMessage)
    {
        <div class="review-feedback review-feedback--success"
             role="alert">

            <span class="review-feedback__icon"
                  aria-hidden="true">
                ✓
            </span>

            <span>
                @successMessage
            </span>

        </div>
    }

    @if (TempData["ReviewError"] is string errorMessage)
    {
        <div class="review-feedback review-feedback--error"
             role="alert">

            <span class="review-feedback__icon"
                  aria-hidden="true">
                !
            </span>

            <span>
                @errorMessage
            </span>

        </div>
    }

    <!-- Summary -->
    <section class="review-moderation-summary">

        <article class="review-stat">

            <div class="review-stat__top">

                <span>
                    TOTAL REVIEWS
                </span>

                <span class="review-stat__icon"
                      aria-hidden="true">
                    R
                </span>

            </div>

            <strong>
                @totalReviews
            </strong>

            <p>
                Customer reviews submitted to DriveFleet.
            </p>

        </article>

        <article class="review-stat review-stat--visible">

            <div class="review-stat__top">

                <span>
                    VISIBLE
                </span>

                <span class="review-stat__icon"
                      aria-hidden="true">
                    ✓
                </span>

            </div>

            <strong>
                @visibleReviews
            </strong>

            <p>
                Reviews currently shown in the public catalog.
            </p>

        </article>

        <article class="review-stat review-stat--hidden">

            <div class="review-stat__top">

                <span>
                    HIDDEN
                </span>

                <span class="review-stat__icon"
                      aria-hidden="true">
                    —
                </span>

            </div>

            <strong>
                @hiddenReviews
            </strong>

            <p>
                Reviews currently hidden from customers.
            </p>

        </article>

        <article class="review-stat review-stat--rating">

            <div class="review-stat__top">

                <span>
                    AVERAGE RATING
                </span>

                <span class="review-stat__icon"
                      aria-hidden="true">
                    ★
                </span>

            </div>

            <strong>
                @averageRating.ToString(
                    "0.0",
                    CultureInfo.InvariantCulture)
            </strong>

            <p>
                Average rating across all submitted reviews.
            </p>

        </article>

    </section>

    <!-- List heading -->
    <div class="review-moderation-heading">

        <div>

            <span>
                CUSTOMER FEEDBACK
            </span>

            <h2>
                Reviews
            </h2>

            <p>
                Review customer feedback and manage public visibility.
            </p>

        </div>

        <div class="review-moderation-heading__insight">

            <span aria-hidden="true">
                ★
            </span>

            <div>

                <strong>
                    @fiveStarReviews
                </strong>

                <small>
                    5-star
                    @(fiveStarReviews == 1
                        ? "review"
                        : "reviews")
                </small>

            </div>

        </div>

    </div>

    @if (totalReviews == 0)
    {
        <!-- Empty state -->
        <section class="review-empty">

            <div class="review-empty__icon"
                 aria-hidden="true">
                ☆
            </div>

            <h2>
                No reviews available
            </h2>

            <p>
                Customer reviews will appear here once
                completed rentals receive feedback.
            </p>

            <a asp-controller="Vehicles"
               asp-action="Index">

                View vehicle catalog

                <span aria-hidden="true">
                    →
                </span>

            </a>

        </section>
    }
    else
    {
        <!-- Review list -->
        <div class="review-list">

            @foreach (var review in orderedReviews)
            {
                var visibilityClass =
                    review.IsVisible
                        ? "visible"
                        : "hidden";

                <article class="review-card review-card--@visibilityClass">

                    <div class="review-card__body">

                        <!-- Rating -->
                        <div class="review-card__rating-column">

                            <div class="review-rating"
                                 aria-label="@review.Stars out of 5 stars">

                                @for (var star = 1;
                                      star <= 5;
                                      star++)
                                {
                                    if (star <= review.Stars)
                                    {
                                        <span class="review-rating__star review-rating__star--filled"
                                              aria-hidden="true">
                                            ★
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="review-rating__star"
                                              aria-hidden="true">
                                            ☆
                                        </span>
                                    }
                                }

                            </div>

                            <strong class="review-rating__value">
                                @review.Stars
                            </strong>

                            <span class="review-rating__caption">
                                out of 5
                            </span>

                        </div>

                        <!-- Main content -->
                        <div class="review-card__content">

                            <div class="review-card__header">

                                <div>

                                    <div class="review-card__identity">

                                        <span class="review-card__number">
                                            Review #@review.ReviewId
                                        </span>

                                        @if (review.IsVisible)
                                        {
                                            <span class="review-visibility review-visibility--visible">

                                                <span class="review-visibility__dot">
                                                </span>

                                                Visible

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="review-visibility review-visibility--hidden">

                                                <span class="review-visibility__dot">
                                                </span>

                                                Hidden

                                            </span>
                                        }

                                    </div>

                                    <span class="review-card__date">
                                        @(review.CreatedAt
                                            .ToLocalTime()
                                            .ToString(
                                                "dd MMM yyyy · HH:mm",
                                                englishCulture))
                                    </span>

                                </div>

                                <a asp-controller="Vehicles"
                                   asp-action="Details"
                                   asp-route-vehicleId="@review.VehicleId"
                                   class="review-card__vehicle-link">

                                    Vehicle #@review.VehicleId

                                    <span aria-hidden="true">
                                        →
                                    </span>

                                </a>

                            </div>

                            <!-- Comment -->
                            <div class="review-comment">

                                @if (string.IsNullOrWhiteSpace(
                                    review.Comment))
                                {
                                    <p class="review-comment__empty">
                                        No written comment was provided
                                        with this rating.
                                    </p>
                                }
                                else
                                {
                                    <p>
                                        @review.Comment
                                    </p>
                                }

                            </div>

                            <!-- Metadata -->
                            <div class="review-card__meta">

                                <div>

                                    <span>
                                        REVIEW ID
                                    </span>

                                    <strong>
                                        #@review.ReviewId
                                    </strong>

                                </div>

                                <div>

                                    <span>
                                        VEHICLE ID
                                    </span>

                                    <strong>
                                        #@review.VehicleId
                                    </strong>

                                </div>

                                <div>

                                    <span>
                                        RESERVATION VEHICLE
                                    </span>

                                    <strong>
                                        #@review.ReservationVehicleId
                                    </strong>

                                </div>

                                <div>

                                    <span>
                                        VISIBILITY
                                    </span>

                                    <strong>
                                        @(review.IsVisible
                                            ? "Public"
                                            : "Hidden")
                                    </strong>

                                </div>

                            </div>

                        </div>

                    </div>

                    <!-- Moderation actions -->
                    <footer class="review-card__footer">

                        <div class="review-card__status">

                            <span class="review-card__status-icon review-card__status-icon--@visibilityClass">
                            </span>

                            <span>
                                @if (review.IsVisible)
                                {
                                    <text>
                                        This review is visible in the public vehicle catalog.
                                    </text>
                                }
                                else
                                {
                                    <text>
                                        This review is currently hidden from the public catalog.
                                    </text>
                                }
                            </span>

                        </div>

                        <div class="review-card__actions">

                            <form asp-controller="Reviews"
                                  asp-action="SetVisibility"
                                  asp-route-reviewId="@review.ReviewId"
                                  method="post">

                                @Html.AntiForgeryToken()

                                @if (review.IsVisible)
                                {
                                    <button type="submit"
                                            name="isVisible"
                                            value="false"
                                            class="review-action review-action--secondary">

                                        <span aria-hidden="true">
                                            —
                                        </span>

                                        Hide review

                                    </button>
                                }
                                else
                                {
                                    <button type="submit"
                                            name="isVisible"
                                            value="true"
                                            class="review-action review-action--primary">

                                        <span aria-hidden="true">
                                            ✓
                                        </span>

                                        Show review

                                    </button>
                                }

                            </form>

                            <form asp-controller="Reviews"
                                  asp-action="Delete"
                                  asp-route-reviewId="@review.ReviewId"
                                  method="post"
                                  onsubmit="return confirm('Are you sure you want to permanently delete this review?');">

                                @Html.AntiForgeryToken()

                                <button type="submit"
                                        class="review-action review-action--danger">

                                    Delete

                                </button>

                            </form>

                        </div>

                    </footer>

                </article>
            }

        </div>
    }

</section>