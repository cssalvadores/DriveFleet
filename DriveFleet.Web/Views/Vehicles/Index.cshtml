@model List<DriveFleet.Web.Models.Vehicles.VehicleListItemViewModel>

@{
    ViewData["Title"] = "Vehicles";
}

<div class="container mt-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h1 class="h3 mb-1">Vehicles</h1>

            <p class="text-muted small mb-0">
                Explore the vehicles currently available in DriveFleet.
            </p>
        </div>

        @* Shows vehicle management actions only to authorized staff. *@
        @if (User.IsInRole("Admin") || User.IsInRole("Employee"))
        {
            <a asp-controller="Vehicles"
               asp-action="Create"
               class="btn btn-primary btn-sm">
                Create vehicle
            </a>
        }
    </div>

    @if (Model.Count == 0)
    {
        <div class="alert alert-info py-2"
             role="alert">
            No vehicles are currently available.
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var vehicle in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm">

                        @if (!string.IsNullOrWhiteSpace(vehicle.MainPhotoUrl))
                        {
                            <div class="ratio ratio-16x9">
                                <img src="@vehicle.MainPhotoUrl"
                                     class="card-img-top object-fit-cover"
                                     alt="@vehicle.Brand @vehicle.Model main catalog photo" />
                            </div>
                        }
                        else
                        {
                            <div class="ratio ratio-16x9 bg-light">
                                <div class="d-flex align-items-center justify-content-center
                                    text-muted small">
                                    No photo available.
                                </div>
                            </div>
                        }

                        <div class="card-body p-3">

                            <h5 class="card-title mb-1">
                                @vehicle.Brand @vehicle.Model
                            </h5>

                            <p class="card-text text-muted small mb-3">
                                @vehicle.Year · @vehicle.CategoryName
                            </p>

                            <dl class="row mb-0 small">
                                <dt class="col-6 mb-1">
                                    Seats
                                </dt>
                                <dd class="col-6 mb-1">
                                    @vehicle.Seats
                                </dd>

                                <dt class="col-6 mb-1">
                                    Daily price
                                </dt>
                                <dd class="col-6 mb-1">
                                    @vehicle.DailyPrice.ToString("0.00") €
                                </dd>

                                <dt class="col-6 mb-1">
                                    Status
                                </dt>
                                <dd class="col-6 mb-1">
                                    @vehicle.VehicleStatusName
                                </dd>
                            </dl>

                            <a asp-controller="Vehicles"
                               asp-action="Details"
                               asp-route-vehicleId="@vehicle.VehicleId"
                               class="btn btn-outline-primary btn-sm mt-2">
                                View details
                            </a>

                        </div>

                    </div>
                </div>
            }
        </div>
    }
</div>
