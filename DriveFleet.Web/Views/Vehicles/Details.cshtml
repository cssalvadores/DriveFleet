@model DriveFleet.Web.Models.Vehicles.VehicleDetailsViewModel

@{
    ViewData["Title"] =
        $"{Model.Brand} {Model.Model}";

    var mainPhoto =
        Model.Photos
            .OrderBy(photo =>
                photo.DisplayOrder)
            .FirstOrDefault(photo =>
                photo.DisplayOrder == 1);

    var secondaryPhotos =
        Model.Photos
            .Where(photo =>
                photo.DisplayOrder != 1)
            .OrderBy(photo =>
                photo.DisplayOrder)
            .ToList();

    var isStaff =
        User.IsInRole("Admin") ||
        User.IsInRole("Employee");

    var isClient =
        User.IsInRole("Client");

    var isUnavailable =
        string.Equals(
            Model.VehicleStatusName,
            "Unavailable",
            StringComparison.OrdinalIgnoreCase);

    var hasReviews =
        Model.Reviews.Count > 0;

    var statusClass =
        Model.VehicleStatusName switch
        {
            "Available" =>
                "vehicle-details-status--available",

            "Reserved" =>
                "vehicle-details-status--reserved",

            "Unavailable" =>
                "vehicle-details-status--unavailable",

            _ =>
                "vehicle-details-status--unavailable"
        };
}

<section class="vehicle-details-page">

    <div class="vehicle-details-shell">

        <a asp-controller="Vehicles"
           asp-action="Index"
           class="vehicle-details-back">
            <span aria-hidden="true">←</span>
            Back to fleet
        </a>

        <header class="vehicle-details-header">

            <div>

                <div class="vehicle-details-eyebrow">
                    @Model.CategoryName
                </div>

                <h1 class="vehicle-details-title">
                    @Model.Brand
                    @Model.Model
                </h1>

                <div class="vehicle-details-meta">

                    <span class="vehicle-details-chip">
                        @Model.Year
                    </span>

                    <span class="vehicle-details-chip">
                        @Model.Seats seats
                    </span>

                    <span class="vehicle-details-chip">
                        @Model.CategoryName
                    </span>

                    @if (Model.AverageRating.HasValue)
                    {
                        <span class="vehicle-details-chip">
                            ★
                            @Model.AverageRating.Value.ToString("0.0")
                            / 5
                        </span>
                    }

                </div>

            </div>

            @if (isStaff)
            {
                <div class="vehicle-details-admin-actions">

                    <a asp-controller="Vehicles"
                       asp-action="Edit"
                       asp-route-vehicleId="@Model.VehicleId"
                       class="vehicle-details-admin-button">
                        Edit vehicle
                    </a>

                    @if (!isUnavailable)
                    {
                        <form asp-controller="Vehicles"
                              asp-action="MarkUnavailable"
                              asp-route-vehicleId="@Model.VehicleId"
                              method="post">

                            @Html.AntiForgeryToken()

                            <button type="submit"
                                    class="vehicle-details-admin-button vehicle-details-admin-button--danger"
                                    onclick="return confirm('Are you sure you want to mark this vehicle as unavailable?');">
                                Mark unavailable
                            </button>

                        </form>
                    }

                </div>
            }

        </header>

        <div class="vehicle-details-grid">

            <div class="vehicle-details-gallery">

                <div class="vehicle-details-main-photo">

                    @if (mainPhoto is not null &&
                         !string.IsNullOrWhiteSpace(
                             mainPhoto.ImageUrl))
                    {
                        <img src="@mainPhoto.ImageUrl"
                             alt="@Model.Brand @Model.Model main view" />
                    }
                    else
                    {
                        <div class="vehicle-details-photo-empty">
                            No photo available
                        </div>
                    }

                </div>

                @if (secondaryPhotos.Count > 0)
                {
                    <div class="vehicle-details-gallery-secondary">

                        @foreach (var photo in secondaryPhotos)
                        {
                            <div class="vehicle-details-thumbnail">

                                @if (!string.IsNullOrWhiteSpace(
                                    photo.ImageUrl))
                                {
                                    <img src="@photo.ImageUrl"
                                         alt="@Model.Brand @Model.Model vehicle view"
                                         loading="lazy" />
                                }
                                else
                                {
                                    <div class="vehicle-details-photo-empty">
                                        No photo available
                                    </div>
                                }

                            </div>
                        }

                    </div>
                }

            </div>

            <aside class="vehicle-details-sidebar">

                <div class="vehicle-details-booking-card">

                    <div class="vehicle-details-booking-top">

                        <div>

                            <div class="vehicle-details-price-label">
                                From
                            </div>

                            <div class="vehicle-details-price">
                                @Model.DailyPrice.ToString("C")
                            </div>

                            <div class="vehicle-details-price-period">
                                per day
                            </div>

                        </div>

                        <span class="vehicle-details-status @statusClass">
                            @Model.VehicleStatusName
                        </span>

                    </div>

                    @if (isClient &&
                         !isUnavailable)
                    {
                        <a asp-controller="Reservations"
                           asp-action="Create"
                           asp-route-vehicleId="@Model.VehicleId"
                           class="vehicle-details-rent-button">
                            Rent this vehicle
                        </a>

                        <p class="vehicle-details-booking-note">
                            Choose your rental dates and extras
                            in the next step. You can also add
                            another vehicle before completing
                            the reservation.
                        </p>
                    }
                    else if (isUnavailable)
                    {
                        <div class="vehicle-details-unavailable">
                            This vehicle is currently unavailable
                            for new reservations.
                        </div>
                    }
                    else if (User.Identity?.IsAuthenticated != true)
                    {
                        <a asp-controller="Account"
                           asp-action="Login"
                           class="vehicle-details-rent-button">
                            Sign in to rent
                        </a>

                        <p class="vehicle-details-booking-note">
                            Sign in to your DriveFleet account
                            to start a reservation.
                        </p>
                    }

                </div>

                <div class="vehicle-details-information-card">

                    <h2 class="vehicle-details-section-title">
                        Vehicle information
                    </h2>

                    <dl class="vehicle-details-specs">

                        <div class="vehicle-details-spec-row">
                            <dt>Brand</dt>
                            <dd>@Model.Brand</dd>
                        </div>

                        <div class="vehicle-details-spec-row">
                            <dt>Model</dt>
                            <dd>@Model.Model</dd>
                        </div>

                        <div class="vehicle-details-spec-row">
                            <dt>Year</dt>
                            <dd>@Model.Year</dd>
                        </div>

                        <div class="vehicle-details-spec-row">
                            <dt>Category</dt>
                            <dd>@Model.CategoryName</dd>
                        </div>

                        <div class="vehicle-details-spec-row">
                            <dt>Seats</dt>
                            <dd>@Model.Seats</dd>
                        </div>

                        <div class="vehicle-details-spec-row">
                            <dt>License plate</dt>
                            <dd>@Model.LicensePlate</dd>
                        </div>

                        <div class="vehicle-details-spec-row">
                            <dt>Status</dt>
                            <dd>@Model.VehicleStatusName</dd>
                        </div>

                    </dl>

                </div>

            </aside>

        </div>

        @if (!string.IsNullOrWhiteSpace(
            Model.Description))
        {
            <section class="vehicle-details-description">

                <div class="vehicle-details-content-eyebrow">
                    About this vehicle
                </div>

                <h2 class="vehicle-details-content-title">
                    Designed for your journey
                </h2>

                <p class="vehicle-details-description-text">
                    @Model.Description
                </p>

            </section>
        }

        <section class="vehicle-details-reviews">

            <div class="vehicle-details-reviews-header">

                <div>

                    <div class="vehicle-details-content-eyebrow">
                        Customer experience
                    </div>

                    <h2 class="vehicle-details-content-title mb-0">
                        Customer reviews
                    </h2>

                </div>

                @if (hasReviews &&
                     Model.AverageRating.HasValue)
                {
                    <div class="vehicle-details-rating-summary">

                        <div class="vehicle-details-rating-value">

                            <span class="vehicle-details-rating-star"
                                  aria-hidden="true">
                                ★
                            </span>

                            <strong>
                                @Model.AverageRating.Value.ToString("0.0")
                            </strong>

                            <span>
                                / 5
                            </span>

                        </div>

                        <div class="vehicle-details-rating-count">
                            Based on
                            @Model.Reviews.Count
                            @(Model.Reviews.Count == 1
                                ? "review"
                                : "reviews")
                        </div>

                    </div>
                }

            </div>

            @if (!hasReviews)
            {
                <div class="vehicle-details-no-reviews">
                    No reviews are available for this vehicle yet.
                </div>
            }
            else
            {
                <div class="vehicle-details-review-list">

                    @foreach (var review in Model.Reviews)
                    {
                        <article class="vehicle-details-review-card">

                            <div class="vehicle-details-review-top">

                                <div class="vehicle-details-review-stars"
                                     aria-label="@($"{review.Stars} out of 5 stars")">

                                    @for (var star = 1;
                                          star <= 5;
                                          star++)
                                    {
                                        <span aria-hidden="true">
                                            @(star <= review.Stars
                                                ? "★"
                                                : "☆")
                                        </span>
                                    }

                                </div>

                                <time class="vehicle-details-review-date"
                                      datetime="@review.CreatedAt.ToString("yyyy-MM-dd")">
                                    @review.CreatedAt.ToString("dd/MM/yyyy")
                                </time>

                            </div>

                            @if (!string.IsNullOrWhiteSpace(
                                review.Comment))
                            {
                                <p class="vehicle-details-review-text">
                                    @review.Comment
                                </p>
                            }
                            else
                            {
                                <p class="vehicle-details-review-text fst-italic">
                                    No written comment.
                                </p>
                            }

                        </article>
                    }

                </div>
            }

        </section>

    </div>

</section>