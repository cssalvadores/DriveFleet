@model DriveFleet.Web.Models.Vehicles.CreateVehicleViewModel

@{
    ViewData["Title"] = "Create vehicle";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm">
                <div class="card-body p-3">

                    <h1 class="h4 mb-3">
                        Create vehicle
                    </h1>

                    <form asp-controller="Vehicles"
                          asp-action="Create"
                          method="post">

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-2">
                                <label asp-for="Brand"
                                       class="form-label">
                                </label>

                                <input asp-for="Brand"
                                       class="form-control form-control-sm" />

                                <span asp-validation-for="Brand"
                                      class="text-danger">
                                </span>
                            </div>

                            <div class="col-md-6 mb-2">
                                <label asp-for="Model"
                                       class="form-label">
                                </label>

                                <input asp-for="Model"
                                       class="form-control form-control-sm" />

                                <span asp-validation-for="Model"
                                      class="text-danger">
                                </span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-2">
                                <label asp-for="Year"
                                       class="form-label">
                                </label>

                                <input asp-for="Year"
                                       class="form-control form-control-sm" />

                                <span asp-validation-for="Year"
                                      class="text-danger">
                                </span>
                            </div>

                            <div class="col-md-6 mb-2">
                                <label asp-for="LicensePlate"
                                       class="form-label">
                                </label>

                                <input asp-for="LicensePlate"
                                       class="form-control form-control-sm" />

                                <span asp-validation-for="LicensePlate"
                                      class="text-danger">
                                </span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-2">
                                <label asp-for="Seats"
                                       class="form-label">
                                </label>

                                <input asp-for="Seats"
                                       class="form-control form-control-sm" />

                                <span asp-validation-for="Seats"
                                      class="text-danger">
                                </span>
                            </div>

                            <div class="col-md-6 mb-2">
                                <label asp-for="DailyPrice"
                                       class="form-label">
                                </label>

                                <input asp-for="DailyPrice"
                                       class="form-control form-control-sm" />

                                <span asp-validation-for="DailyPrice"
                                      class="text-danger">
                                </span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-2">
                                <label asp-for="CategoryId"
                                       class="form-label">
                                </label>

                                <select asp-for="CategoryId"
                                        asp-items="Model.Categories"
                                        class="form-select form-select-sm">
                                    <option value="0">
                                        Select a category
                                    </option>
                                </select>

                                <span asp-validation-for="CategoryId"
                                      class="text-danger">
                                </span>
                            </div>

                            <div class="col-md-6 mb-2">
                                <label asp-for="VehicleStatusId"
                                       class="form-label">
                                </label>

                                <select asp-for="VehicleStatusId"
                                        asp-items="Model.VehicleStatuses"
                                        class="form-select form-select-sm">
                                    <option value="0">
                                        Select a status
                                    </option>
                                </select>

                                <span asp-validation-for="VehicleStatusId"
                                      class="text-danger">
                                </span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description"
                                   class="form-label">
                            </label>

                            <textarea asp-for="Description"
                                      class="form-control form-control-sm"
                                      rows="3">
                            </textarea>

                            <span asp-validation-for="Description"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit"
                                    class="btn btn-primary btn-sm">
                                Create vehicle
                            </button>

                            <a asp-controller="Vehicles"
                               asp-action="Index"
                               class="btn btn-outline-secondary btn-sm">
                                Cancel
                            </a>
                        </div>

                    </form>

                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />    
}
