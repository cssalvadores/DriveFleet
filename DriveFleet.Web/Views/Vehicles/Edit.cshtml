@model DriveFleet.Web.Models.Vehicles.EditVehicleViewModel

@{
    ViewData["Title"] = "Edit vehicle";

    var categoryName =
        Model.Categories
            .FirstOrDefault(item =>
                item.Value ==
                Model.CategoryId.ToString())
            ?.Text
        ?? "Not selected";

    var statusName =
        Model.VehicleStatuses
            .FirstOrDefault(item =>
                item.Value ==
                Model.VehicleStatusId.ToString())
            ?.Text
        ?? "Not selected";

    var uploadedPhotoCount =
        Model.Photos.Count;
}

<link rel="stylesheet"
      href="~/css/vehicle-management.css"
      asp-append-version="true" />

<section class="vehicle-management-page">

    <div class="vehicle-management-back">

        <a asp-controller="Vehicles"
           asp-action="Details"
           asp-route-vehicleId="@Model.VehicleId"
           class="vehicle-management-back__link">

            <span aria-hidden="true">
                ←
            </span>

            <span>
                Back to vehicle
            </span>

        </a>

    </div>

    <!-- Hero -->
    <header class="vehicle-management-hero">

        <div class="vehicle-management-hero__content">

            <div>

                <span class="vehicle-management-eyebrow">
                    FLEET MANAGEMENT
                </span>

                <h1>
                    Edit vehicle
                </h1>

                <p>
                    Update vehicle information, operational settings
                    and catalog photography.
                </p>

            </div>

            <div class="vehicle-management-hero__badge">

                <span class="vehicle-management-hero__badge-icon"
                      aria-hidden="true">
                    #@Model.VehicleId
                </span>

                <div>
                    <strong>
                        @Model.Brand @Model.Model
                    </strong>

                    <span>
                        @Model.LicensePlate
                    </span>
                </div>

            </div>

        </div>

        <div class="vehicle-management-hero__steps">

            <div class="vehicle-management-hero-step vehicle-management-hero-step--active">

                <span>
                    01
                </span>

                <div>
                    <strong>
                        Information
                    </strong>

                    <small>
                        Vehicle data
                    </small>
                </div>

            </div>

            <div class="vehicle-management-hero__line">
            </div>

            <div class="vehicle-management-hero-step vehicle-management-hero-step--active">

                <span>
                    02
                </span>

                <div>
                    <strong>
                        Operations
                    </strong>

                    <small>
                        Category &amp; status
                    </small>
                </div>

            </div>

            <div class="vehicle-management-hero__line">
            </div>

            <div class="vehicle-management-hero-step vehicle-management-hero-step--active">

                <span>
                    03
                </span>

                <div>
                    <strong>
                        Photography
                    </strong>

                    <small>
                        Catalog assets
                    </small>
                </div>

            </div>

        </div>

    </header>

    <!-- Vehicle information form -->
    <form asp-controller="Vehicles"
          asp-action="Edit"
          asp-route-vehicleId="@Model.VehicleId"
          method="post"
          asp-antiforgery="true">

        <input asp-for="VehicleId"
               type="hidden" />

        <div asp-validation-summary="ModelOnly"
             class="vehicle-management-validation"
             role="alert">
        </div>

        <div class="vehicle-management-layout">

            <div class="vehicle-management-main">

                <!-- Identity -->
                <section class="vehicle-form-card">

                    <header class="vehicle-form-card__header">

                        <span class="vehicle-form-card__number">
                            01
                        </span>

                        <div>

                            <span class="vehicle-form-card__eyebrow">
                                VEHICLE IDENTITY
                            </span>

                            <h2>
                                Basic information
                            </h2>

                            <p>
                                Update the identifying information
                                associated with this fleet vehicle.
                            </p>

                        </div>

                    </header>

                    <div class="vehicle-form-grid">

                        <div class="vehicle-form-field">

                            <label asp-for="Brand">
                            </label>

                            <input asp-for="Brand"
                                   class="form-control" />

                            <span asp-validation-for="Brand"
                                  class="vehicle-form-error">
                            </span>

                        </div>

                        <div class="vehicle-form-field">

                            <label asp-for="Model">
                            </label>

                            <input asp-for="Model"
                                   class="form-control" />

                            <span asp-validation-for="Model"
                                  class="vehicle-form-error">
                            </span>

                        </div>

                        <div class="vehicle-form-field">

                            <label asp-for="Year">
                            </label>

                            <input asp-for="Year"
                                   class="form-control" />

                            <span asp-validation-for="Year"
                                  class="vehicle-form-error">
                            </span>

                        </div>

                        <div class="vehicle-form-field">

                            <label asp-for="LicensePlate">
                            </label>

                            <input asp-for="LicensePlate"
                                   class="form-control" />

                            <span asp-validation-for="LicensePlate"
                                  class="vehicle-form-error">
                            </span>

                        </div>

                    </div>

                </section>

                <!-- Commercial -->
                <section class="vehicle-form-card">

                    <header class="vehicle-form-card__header">

                        <span class="vehicle-form-card__number">
                            02
                        </span>

                        <div>

                            <span class="vehicle-form-card__eyebrow">
                                RENTAL CONFIGURATION
                            </span>

                            <h2>
                                Commercial details
                            </h2>

                            <p>
                                Maintain vehicle capacity and
                                daily rental pricing.
                            </p>

                        </div>

                    </header>

                    <div class="vehicle-form-grid">

                        <div class="vehicle-form-field">

                            <label asp-for="Seats">
                            </label>

                            <div class="vehicle-form-input-unit">

                                <input asp-for="Seats"
                                       class="form-control" />

                                <span>
                                    seats
                                </span>

                            </div>

                            <span asp-validation-for="Seats"
                                  class="vehicle-form-error">
                            </span>

                        </div>

                        <div class="vehicle-form-field">

                            <label asp-for="DailyPrice">
                            </label>

                            <div class="vehicle-form-input-unit">

                                <input asp-for="DailyPrice"
                                       class="form-control" />

                                <span>
                                    € / day
                                </span>

                            </div>

                            <span asp-validation-for="DailyPrice"
                                  class="vehicle-form-error">
                            </span>

                        </div>

                    </div>

                </section>

                <!-- Classification -->
                <section class="vehicle-form-card">

                    <header class="vehicle-form-card__header">

                        <span class="vehicle-form-card__number">
                            03
                        </span>

                        <div>

                            <span class="vehicle-form-card__eyebrow">
                                FLEET CLASSIFICATION
                            </span>

                            <h2>
                                Category and status
                            </h2>

                            <p>
                                Control how the vehicle is classified
                                and its current operational state.
                            </p>

                        </div>

                    </header>

                    <div class="vehicle-form-grid">

                        <div class="vehicle-form-field">

                            <label asp-for="CategoryId">
                            </label>

                            <select asp-for="CategoryId"
                                    asp-items="Model.Categories"
                                    class="form-select">

                                <option value="0">
                                    Select a category
                                </option>

                            </select>

                            <span asp-validation-for="CategoryId"
                                  class="vehicle-form-error">
                            </span>

                        </div>

                        <div class="vehicle-form-field">

                            <label asp-for="VehicleStatusId">
                            </label>

                            <select asp-for="VehicleStatusId"
                                    asp-items="Model.VehicleStatuses"
                                    class="form-select">

                                <option value="0">
                                    Select a status
                                </option>

                            </select>

                            <span asp-validation-for="VehicleStatusId"
                                  class="vehicle-form-error">
                            </span>

                        </div>

                    </div>

                </section>

                <!-- Description -->
                <section class="vehicle-form-card">

                    <header class="vehicle-form-card__header">

                        <span class="vehicle-form-card__number">
                            04
                        </span>

                        <div>

                            <span class="vehicle-form-card__eyebrow">
                                CATALOG CONTENT
                            </span>

                            <h2>
                                Description
                            </h2>

                            <p>
                                Maintain the description presented
                                alongside the vehicle information.
                            </p>

                        </div>

                    </header>

                    <div class="vehicle-form-field">

                        <label asp-for="Description">
                        </label>

                        <textarea asp-for="Description"
                                  class="form-control vehicle-form-description"
                                  rows="5">
                        </textarea>

                        <div class="vehicle-form-helper">

                            <span>
                                Optional
                            </span>

                            <span>
                                Maximum 1000 characters
                            </span>

                        </div>

                        <span asp-validation-for="Description"
                              class="vehicle-form-error">
                        </span>

                    </div>

                </section>

            </div>

            <!-- Summary -->
            <aside class="vehicle-management-sidebar">

                <div class="vehicle-management-summary">

                    <span class="vehicle-management-summary__eyebrow">
                        VEHICLE #@Model.VehicleId
                    </span>

                    <h2>
                        @Model.Brand @Model.Model
                    </h2>

                    <p>
                        Current DriveFleet fleet record.
                    </p>

                    <div class="vehicle-management-summary__divider">
                    </div>

                    <dl class="vehicle-management-current">

                        <div>

                            <dt>
                                License plate
                            </dt>

                            <dd>
                                @Model.LicensePlate
                            </dd>

                        </div>

                        <div>

                            <dt>
                                Category
                            </dt>

                            <dd>
                                @categoryName
                            </dd>

                        </div>

                        <div>

                            <dt>
                                Status
                            </dt>

                            <dd>
                                @statusName
                            </dd>

                        </div>

                        <div>

                            <dt>
                                Photos
                            </dt>

                            <dd>
                                @uploadedPhotoCount / 3
                            </dd>

                        </div>

                    </dl>

                    <div class="vehicle-management-summary__notice">

                        <span aria-hidden="true">
                            i
                        </span>

                        <p>
                            Saving vehicle information does not
                            replace or remove the existing catalog photos.
                        </p>

                    </div>

                    <div class="vehicle-management-summary__actions">

                        <button type="submit"
                                class="vehicle-management-submit">

                            <span>
                                Save changes
                            </span>

                            <span aria-hidden="true">
                                →
                            </span>

                        </button>

                        <a asp-controller="Vehicles"
                           asp-action="Details"
                           asp-route-vehicleId="@Model.VehicleId"
                           class="vehicle-management-cancel">
                            Cancel
                        </a>

                    </div>

                </div>

            </aside>

        </div>

    </form>

    <!-- Photos -->
    <section class="vehicle-photo-management">

        <header class="vehicle-photo-management__heading">

            <div>

                <span>
                    CATALOG ASSETS
                </span>

                <h2>
                    Vehicle photos
                </h2>

                <p>
                    Upload up to three catalog photos.
                    Photo 1 is used as the main vehicle image.
                </p>

            </div>

            <div class="vehicle-photo-management__counter">

                <strong>
                    @uploadedPhotoCount
                </strong>

                <span>
                    of 3 uploaded
                </span>

            </div>

        </header>

        @if (TempData["VehiclePhotoSuccess"] is string successMessage)
        {
            <div class="vehicle-photo-feedback vehicle-photo-feedback--success"
                 role="alert">

                <span aria-hidden="true">
                    ✓
                </span>

                <span>
                    @successMessage
                </span>

            </div>
        }

        @if (TempData["VehiclePhotoError"] is string errorMessage)
        {
            <div class="vehicle-photo-feedback vehicle-photo-feedback--error"
                 role="alert">

                <span aria-hidden="true">
                    !
                </span>

                <span>
                    @errorMessage
                </span>

            </div>
        }

        <div class="vehicle-photo-grid">

            @for (var displayOrder = 1;
                  displayOrder <= 3;
                  displayOrder++)
            {
                var existingPhoto =
                    Model.Photos.FirstOrDefault(
                        photo =>
                            photo.DisplayOrder ==
                            displayOrder);

                var hasPhoto =
                    existingPhoto is not null;

                <article class="vehicle-photo-slot @(hasPhoto
                                        ? "vehicle-photo-slot--uploaded"
                                        : string.Empty)">

            <div class="vehicle-photo-slot__top">

                <div class="vehicle-photo-slot__number">
                    @displayOrder
                </div>

                @if (displayOrder == 1)
                {
                    <span class="vehicle-photo-slot__main-badge">
                        MAIN PHOTO
                    </span>
                }
                else
                {
                    <span class="vehicle-photo-slot__secondary-badge">
                        GALLERY
                    </span>
                }

            </div>

            <div class="vehicle-photo-slot__visual">

                @if (hasPhoto)
                {
                    <div class="vehicle-photo-slot__state vehicle-photo-slot__state--uploaded">

                        <span aria-hidden="true">
                            ✓
                        </span>

                        <strong>
                            Photo uploaded
                        </strong>

                        <small>
                            Ready for catalog display
                        </small>

                    </div>
                }
                else
                {
                    <div class="vehicle-photo-slot__state">

                        <span aria-hidden="true">
                            +
                        </span>

                        <strong>
                            No photo
                        </strong>

                        <small>
                            JPG or PNG
                        </small>

                    </div>
                }

            </div>

            <div class="vehicle-photo-slot__content">

                <div>

                    <strong>
                        @(displayOrder == 1
                            ? "Primary catalog photo"
                            : $"Catalog photo {displayOrder}")
                    </strong>

                    <p>
                        @(hasPhoto
                            ? "Replace the existing image by selecting another file."
                            : "Select an image to fill this catalog position.")
                    </p>

                </div>

                <form asp-controller="Vehicles"
                      asp-action="SetPhoto"
                      asp-route-vehicleId="@Model.VehicleId"
                      asp-route-displayOrder="@displayOrder"
                      method="post"
                      enctype="multipart/form-data"
                      class="vehicle-photo-upload">

                    <input type="file"
                           name="photo"
                           accept=".jpg,.jpeg,.png,image/jpeg,image/png"
                           class="form-control" />

                    <button type="submit"
                            class="vehicle-photo-upload__button">

                        @(hasPhoto
                            ? "Replace photo"
                            : "Upload photo")

                        <span aria-hidden="true">
                            ↑
                        </span>

                    </button>

                </form>

            </div>

        </article>
    }

</div>

<div class="vehicle-photo-management__footer">

    <div>

        <span aria-hidden="true">
            i
        </span>

        <p>
            Changing a photo affects the catalog image
            associated with this vehicle position.
        </p>

    </div>

    <a asp-controller="Vehicles"
       asp-action="Details"
       asp-route-vehicleId="@Model.VehicleId">

        Preview vehicle →

    </a>

</div>

</section>

</section>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}