@model IEnumerable<DriveFleet.Web.Models.Reservations.ReservationViewModel>

@using DriveFleet.Web.Helpers

<div class="d-flex flex-column gap-3">

    @foreach (var reservation in Model)
    {
        <article class="card shadow-sm">

            <div class="card-body p-3">

                @* Reservation summary. *@
                <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-3">

                    <div>
                        <div class="d-flex flex-wrap align-items-center gap-2 mb-1">

                            <h2 class="h6 fw-bold mb-0">
                                Reservation #@reservation.ReservationId
                            </h2>

                            <span class="badge @ReservationDisplayHelper.GetStatusBadgeClass(
                                                                reservation.ReservationStatusName)">
                                @reservation.ReservationStatusName
                            </span>

                        </div>

                        <div class="small text-muted">
                            Created
                            @ReservationDisplayHelper.FormatDateTime(
                                reservation.CreatedAt)
                        </div>
                    </div>

                    <div class="text-end">

                        <div class="small text-muted">
                            Total
                        </div>

                        <div class="fs-5 fw-bold">
                            @reservation.TotalValue.ToString("C")
                        </div>

                    </div>

                </div>

                @* Vehicles included in the reservation. *@
                <div class="border-top border-bottom">

                    @foreach (var vehicle in reservation.Vehicles)
                    {
                        <div class="py-3 border-bottom">

                            <div class="row align-items-start g-3">

                                <div class="col-md-4">

                                    <div class="fw-semibold">
                                        @vehicle.VehicleBrand
                                        @vehicle.VehicleModel
                                    </div>

                                    <div class="small text-muted">
                                        @vehicle.LicensePlate
                                    </div>

                                    @if (vehicle.Extras.Count > 0)
                                    {
                                        <div class="mt-2">

                                            <div class="small text-muted mb-1">
                                                Extras
                                            </div>

                                            <div class="d-flex flex-wrap gap-1">

                                                @foreach (var extra in vehicle.Extras)
                                                {
                                                    <span class="badge rounded-pill text-bg-light border text-dark fw-normal">
                                                        @extra.Name
                                                        × @extra.Quantity
                                                        ·
                                                        @extra.Total.ToString("C")
                                                    </span>
                                                }

                                            </div>

                                        </div>
                                    }

                                </div>

                                <div class="col-md-3">

                                    <div class="small text-muted">
                                        Pick-up
                                    </div>

                                    <div class="small fw-semibold">
                                        @ReservationDisplayHelper.FormatDateTime(
                                            vehicle.StartDate)
                                    </div>

                                </div>

                                <div class="col-md-3">

                                    <div class="small text-muted">
                                        Return
                                    </div>

                                    <div class="small fw-semibold">
                                        @ReservationDisplayHelper.FormatDateTime(
                                            vehicle.EndDate)
                                    </div>

                                </div>

                                <div class="col-md-2 text-md-end">

                                    <div class="small text-muted">
                                        Vehicle total
                                    </div>

                                    <div class="fw-semibold">
                                        @vehicle.TotalValue.ToString("C")
                                    </div>

                                    @if (vehicle.ExtrasValue > 0)
                                    {
                                        <div class="small text-muted mt-1">
                                            Extras:
                                            @vehicle.ExtrasValue.ToString("C")
                                        </div>
                                    }

                                </div>

                            </div>

                        </div>
                    }

                </div>

                @* Reservation actions. *@
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mt-3">

                    <div class="small text-muted">
                        @ReservationDisplayHelper.GetVehicleCountText(
                            reservation.Vehicles.Count)
                    </div>

                    <a asp-controller="Reservations"
                       asp-action="Details"
                       asp-route-reservationId="@reservation.ReservationId"
                       class="btn btn-outline-primary btn-sm">
                        View details
                    </a>

                </div>

            </div>

        </article>
    }

</div>
