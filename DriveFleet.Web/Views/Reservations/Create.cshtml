@model DriveFleet.Web.Models.Reservations.CreateReservationViewModel

@using System.Globalization

@{
    ViewData["Title"] = "Create reservation";

    var portugueseCulture =
        CultureInfo.GetCultureInfo("pt-PT");
}

<link rel="stylesheet"
      href="~/css/reservations.css"
      asp-append-version="true" />

<section class="reservation-create-page">

    <!-- Back navigation -->
    <div class="reservation-create-back">

        <a asp-controller="Vehicles"
           asp-action="Index"
           class="reservation-create-back__link">

            <span aria-hidden="true">
                ←
            </span>

            <span>
                Back to fleet
            </span>

        </a>

    </div>

    <!-- Hero -->
    <header class="reservation-create-hero">

        <div class="reservation-create-hero__content">

            <span class="reservation-create-eyebrow">
                NEW RENTAL
            </span>

            <div class="reservation-create-hero__main">

                <div>

                    <h1>
                        Create reservation
                    </h1>

                    <p>
                        Configure the rental period, optional extras
                        and vehicles included in your booking.
                    </p>

                </div>

                <div class="reservation-create-hero__counter">

                    <strong>
                        @Model.Vehicles.Count
                    </strong>

                    <span>
                        @(Model.Vehicles.Count == 1
                            ? "vehicle selected"
                            : "vehicles selected")
                    </span>

                </div>

            </div>

        </div>

        <!-- Progress -->
        <div class="reservation-create-progress">

            <div class="reservation-create-step reservation-create-step--active">

                <span>
                    01
                </span>

                <div>
                    <strong>
                        Vehicles
                    </strong>

                    <small>
                        Selected fleet
                    </small>
                </div>

            </div>

            <div class="reservation-create-progress__line">
            </div>

            <div class="reservation-create-step reservation-create-step--active">

                <span>
                    02
                </span>

                <div>
                    <strong>
                        Rental period
                    </strong>

                    <small>
                        Pick-up & return
                    </small>
                </div>

            </div>

            <div class="reservation-create-progress__line">
            </div>

            <div class="reservation-create-step reservation-create-step--active">

                <span>
                    03
                </span>

                <div>
                    <strong>
                        Extras
                    </strong>

                    <small>
                        Optional services
                    </small>
                </div>

            </div>

            <div class="reservation-create-progress__line">
            </div>

            <div class="reservation-create-step">

                <span>
                    04
                </span>

                <div>
                    <strong>
                        Confirm
                    </strong>

                    <small>
                        Create booking
                    </small>
                </div>

            </div>

        </div>

    </header>

    <form asp-controller="Reservations"
          asp-action="Create"
          method="post"
          asp-antiforgery="true">

        <!-- Validation summary -->
        <div asp-validation-summary="ModelOnly"
             class="reservation-create-validation"
             role="alert">
        </div>

        @if (Model.Vehicles.Count == 0)
        {
            <section class="reservation-create-empty">

                <div class="reservation-create-empty__icon">
                    +
                </div>

                <h2>
                    No vehicles selected
                </h2>

                <p>
                    Select a vehicle from the fleet before creating
                    a reservation.
                </p>

                <a asp-controller="Vehicles"
                   asp-action="Index"
                   class="reservation-create-primary-link">

                    Browse vehicles

                    <span aria-hidden="true">
                        →
                    </span>

                </a>

            </section>
        }
        else
        {
            <div class="reservation-create-layout">

                <!-- Main reservation configuration -->
                <div class="reservation-create-main">

                    <div class="reservation-create-section-heading">

                        <div>

                            <span>
                                RESERVATION CONFIGURATION
                            </span>

                            <h2>
                                Selected vehicles
                            </h2>

                            <p>
                                Each vehicle can have its own rental period
                                and optional extras.
                            </p>

                        </div>

                        <div class="reservation-create-section-count">
                            @Model.Vehicles.Count
                            @(Model.Vehicles.Count == 1
                                ? "vehicle"
                                : "vehicles")
                        </div>

                    </div>

                    <div class="reservation-create-vehicle-list">

                        @for (var vehicleIndex = 0;
                              vehicleIndex < Model.Vehicles.Count;
                              vehicleIndex++)
                        {
                            var vehicle =
                                Model.Vehicles[vehicleIndex];

                            <article class="reservation-create-vehicle">

                                <input asp-for="Vehicles[vehicleIndex].VehicleId"
                                       type="hidden" />

                                <!-- Vehicle header -->
                                <div class="reservation-create-vehicle__header">

                                    <div class="reservation-create-vehicle__index">
                                        @(vehicleIndex + 1)
                                    </div>

                                    <div class="reservation-create-vehicle__identity">

                                        <span>
                                            VEHICLE @(vehicleIndex + 1)
                                        </span>

                                        <h3>
                                            @vehicle.Brand @vehicle.Model
                                        </h3>

                                        <div>
                                            <span>
                                                @vehicle.LicensePlate
                                            </span>

                                            <span aria-hidden="true">
                                                ·
                                            </span>

                                            <strong>
                                                @vehicle.DailyPrice.ToString(
                                                    "C2",
                                                    portugueseCulture)
                                                / day
                                            </strong>
                                        </div>

                                    </div>

                                    <a asp-controller="Vehicles"
                                       asp-action="Details"
                                       asp-route-vehicleId="@vehicle.VehicleId"
                                       class="reservation-create-vehicle__details">

                                        Vehicle details

                                        <span aria-hidden="true">
                                            →
                                        </span>

                                    </a>

                                </div>

                                <div class="reservation-create-vehicle__body">

                                    <!-- Rental period -->
                                    <section class="reservation-create-block">

                                        <div class="reservation-create-block__heading">

                                            <div class="reservation-create-block__number">
                                                01
                                            </div>

                                            <div>

                                                <h4>
                                                    Rental period
                                                </h4>

                                                <p>
                                                    Choose the pick-up and return
                                                    date and time for this vehicle.
                                                </p>

                                            </div>

                                        </div>

                                        <div class="reservation-create-date-grid">

                                            <div class="reservation-create-field">

                                                <label asp-for="Vehicles[vehicleIndex].StartDate">
                                                    Pick-up date and time
                                                </label>

                                                <div class="reservation-create-input-wrap">

                                                    <span class="reservation-create-input-icon"
                                                          aria-hidden="true">
                                                        ↑
                                                    </span>

                                                    <input asp-for="Vehicles[vehicleIndex].StartDate"
                                                           type="datetime-local"
                                                           class="form-control"
                                                           asp-format="{0:yyyy-MM-ddTHH:mm}" />

                                                </div>

                                                <span asp-validation-for="Vehicles[vehicleIndex].StartDate"
                                                      class="reservation-create-field-error">
                                                </span>

                                            </div>

                                            <div class="reservation-create-period-arrow"
                                                 aria-hidden="true">
                                                →
                                            </div>

                                            <div class="reservation-create-field">

                                                <label asp-for="Vehicles[vehicleIndex].EndDate">
                                                    Return date and time
                                                </label>

                                                <div class="reservation-create-input-wrap">

                                                    <span class="reservation-create-input-icon"
                                                          aria-hidden="true">
                                                        ↓
                                                    </span>

                                                    <input asp-for="Vehicles[vehicleIndex].EndDate"
                                                           type="datetime-local"
                                                           class="form-control"
                                                           asp-format="{0:yyyy-MM-ddTHH:mm}" />

                                                </div>

                                                <span asp-validation-for="Vehicles[vehicleIndex].EndDate"
                                                      class="reservation-create-field-error">
                                                </span>

                                            </div>

                                        </div>

                                    </section>

                                    <!-- Extras -->
                                    <section class="reservation-create-block reservation-create-block--extras">

                                        <div class="reservation-create-block__heading">

                                            <div class="reservation-create-block__number">
                                                02
                                            </div>

                                            <div>

                                                <h4>
                                                    Optional extras
                                                </h4>

                                                <p>
                                                    Add services to this vehicle.
                                                    Leave quantity at 0 when not required.
                                                </p>

                                            </div>

                                        </div>

                                        @if (vehicle.Extras.Count > 0)
                                        {
                                            <div class="reservation-create-extras-grid">

                                                @for (var extraIndex = 0;
                                                      extraIndex < vehicle.Extras.Count;
                                                      extraIndex++)
                                                {
                                                    var extra =
                                                        vehicle.Extras[extraIndex];

                                                    <div class="reservation-create-extra">

                                                        <input asp-for="Vehicles[vehicleIndex].Extras[extraIndex].ExtraId"
                                                               type="hidden" />

                                                        <div class="reservation-create-extra__top">

                                                            <div class="reservation-create-extra__icon"
                                                                 aria-hidden="true">
                                                                +
                                                            </div>

                                                            <div class="reservation-create-extra__price">

                                                                <strong>
                                                                    @extra.Price.ToString(
                                                                        "C2",
                                                                        portugueseCulture)
                                                                </strong>

                                                                <span>
                                                                    each
                                                                </span>

                                                            </div>

                                                        </div>

                                                        <div class="reservation-create-extra__content">

                                                            <strong>
                                                                @extra.Name
                                                            </strong>

                                                            <span>
                                                                Optional rental service
                                                            </span>

                                                        </div>

                                                        <div class="reservation-create-extra__quantity">

                                                            <label asp-for="Vehicles[vehicleIndex].Extras[extraIndex].Quantity">
                                                                Quantity
                                                            </label>

                                                            <div class="reservation-create-quantity">

                                                                <input asp-for="Vehicles[vehicleIndex].Extras[extraIndex].Quantity"
                                                                       type="number"
                                                                       min="0"
                                                                       step="1"
                                                                       class="form-control" />

                                                            </div>

                                                        </div>

                                                    </div>
                                                }

                                            </div>
                                        }
                                        else
                                        {
                                            <div class="reservation-create-no-extras">

                                                <span aria-hidden="true">
                                                    —
                                                </span>

                                                <div>

                                                    <strong>
                                                        No extras available
                                                    </strong>

                                                    <p>
                                                        There are currently no optional
                                                        services available for this vehicle.
                                                    </p>

                                                </div>

                                            </div>
                                        }

                                    </section>

                                </div>

                            </article>
                        }

                    </div>

                    <!-- Add vehicle -->
                    <section class="reservation-create-add">

                        <div>

                            <span class="reservation-create-add__eyebrow">
                                MULTI-VEHICLE BOOKING
                            </span>

                            <h3>
                                Need another vehicle?
                            </h3>

                            <p>
                                Add another available vehicle to the same reservation.
                            </p>

                        </div>

                        @if (Model.AvailableVehicles.Count > 0)
                        {
                            <button type="button"
                                    class="reservation-create-add__button"
                                    data-bs-toggle="modal"
                                    data-bs-target="#addVehicleModal">

                                <span aria-hidden="true">
                                    +
                                </span>

                                Add another vehicle

                            </button>
                        }
                        else
                        {
                            <span class="reservation-create-add__unavailable">
                                No other vehicles are currently available.
                            </span>
                        }

                    </section>

                </div>

                <!-- Booking summary -->
                <aside class="reservation-create-summary">

                    <div class="reservation-create-summary__card">

                        <span class="reservation-create-summary__eyebrow">
                            BOOKING SUMMARY
                        </span>

                        <h2>
                            Your reservation
                        </h2>

                        <p>
                            Review the vehicles included before confirming.
                        </p>

                        <div class="reservation-create-summary__divider">
                        </div>

                        <div class="reservation-create-summary__vehicles">

                            @for (var summaryIndex = 0;
                                  summaryIndex < Model.Vehicles.Count;
                                  summaryIndex++)
                            {
                                var summaryVehicle =
                                    Model.Vehicles[summaryIndex];

                                <div class="reservation-create-summary__vehicle">

                                    <div class="reservation-create-summary__vehicle-number">
                                        @(summaryIndex + 1)
                                    </div>

                                    <div>

                                        <strong>
                                            @summaryVehicle.Brand
                                            @summaryVehicle.Model
                                        </strong>

                                        <span>
                                            @summaryVehicle.LicensePlate
                                        </span>

                                    </div>

                                    <strong class="reservation-create-summary__rate">
                                        @summaryVehicle.DailyPrice.ToString(
                                            "C2",
                                            portugueseCulture)
                                        <small>
                                            / day
                                        </small>
                                    </strong>

                                </div>
                            }

                        </div>

                        <div class="reservation-create-summary__divider">
                        </div>

                        <div class="reservation-create-summary__notice">

                            <span aria-hidden="true">
                                i
                            </span>

                            <p>
                                The final amount is calculated by DriveFleet
                                after the reservation is submitted, based on
                                rental duration and selected extras.
                            </p>

                        </div>

                        <div class="reservation-create-summary__actions">

                            <button type="submit"
                                    class="reservation-create-submit">

                                Create reservation

                                <span aria-hidden="true">
                                    →
                                </span>

                            </button>

                            <a asp-controller="Reservations"
                               asp-action="Index"
                               class="reservation-create-cancel">
                                Cancel
                            </a>

                        </div>

                    </div>

                    <div class="reservation-create-security">

                        <div class="reservation-create-security__icon"
                             aria-hidden="true">
                            ✓
                        </div>

                        <div>

                            <strong>
                                Secure reservation
                            </strong>

                            <span>
                                Availability and final pricing are validated
                                by DriveFleet before the booking is created.
                            </span>

                        </div>

                    </div>

                </aside>

            </div>
        }

        <!-- Add vehicle modal -->
        @if (Model.AvailableVehicles.Count > 0)
        {
            <div class="modal fade reservation-vehicle-modal"
                 id="addVehicleModal"
                 tabindex="-1"
                 aria-labelledby="addVehicleModalLabel"
                 aria-hidden="true">

                <div class="modal-dialog modal-xl modal-dialog-scrollable">

                    <div class="modal-content">

                        <div class="modal-header reservation-vehicle-modal__header">

                            <div>

                                <span>
                                    AVAILABLE FLEET
                                </span>

                                <h2 class="modal-title"
                                    id="addVehicleModalLabel">
                                    Add another vehicle
                                </h2>

                                <p>
                                    Select another vehicle to include
                                    in this reservation.
                                </p>

                            </div>

                            <button type="button"
                                    class="btn-close"
                                    data-bs-dismiss="modal"
                                    aria-label="Close">
                            </button>

                        </div>

                        <div class="modal-body reservation-vehicle-modal__body">

                            <div class="reservation-vehicle-modal__grid">

                                @foreach (var availableVehicle
                                    in Model.AvailableVehicles)
                                {
                                    <article class="reservation-vehicle-option">

                                        <div class="reservation-vehicle-option__image">

                                            @if (!string.IsNullOrWhiteSpace(
                                                availableVehicle.MainPhotoUrl))
                                            {
                                                <img src="@availableVehicle.MainPhotoUrl"
                                                     alt="@availableVehicle.Brand @availableVehicle.Model"
                                                     loading="lazy" />
                                            }
                                            else
                                            {
                                                <div class="reservation-vehicle-option__placeholder">

                                                    <span>
                                                        DRIVEFLEET
                                                    </span>

                                                    <small>
                                                        No photo available
                                                    </small>

                                                </div>
                                            }

                                        </div>

                                        <div class="reservation-vehicle-option__body">

                                            <div class="reservation-vehicle-option__heading">

                                                <div>

                                                    <span>
                                                        @availableVehicle.CategoryName
                                                    </span>

                                                    <h3>
                                                        @availableVehicle.Brand
                                                        @availableVehicle.Model
                                                    </h3>

                                                </div>

                                                <strong>
                                                    @availableVehicle.DailyPrice.ToString(
                                                        "C2",
                                                        portugueseCulture)
                                                    <small>
                                                        / day
                                                    </small>
                                                </strong>

                                            </div>

                                            <div class="reservation-vehicle-option__meta">

                                                <div>

                                                    <span>
                                                        YEAR
                                                    </span>

                                                    <strong>
                                                        @availableVehicle.Year
                                                    </strong>

                                                </div>

                                                <div>

                                                    <span>
                                                        SEATS
                                                    </span>

                                                    <strong>
                                                        @availableVehicle.Seats
                                                    </strong>

                                                </div>

                                                <div>

                                                    <span>
                                                        PLATE
                                                    </span>

                                                    <strong>
                                                        @availableVehicle.LicensePlate
                                                    </strong>

                                                </div>

                                            </div>

                                            <button type="submit"
                                                    name="VehicleToAddId"
                                                    value="@availableVehicle.VehicleId"
                                                    class="reservation-vehicle-option__button"
                                                    formnovalidate>

                                                Add vehicle

                                                <span aria-hidden="true">
                                                    +
                                                </span>

                                            </button>

                                        </div>

                                    </article>
                                }

                            </div>

                        </div>

                        <div class="modal-footer reservation-vehicle-modal__footer">

                            <button type="button"
                                    class="reservation-vehicle-modal__close"
                                    data-bs-dismiss="modal">
                                Close
                            </button>

                        </div>

                    </div>

                </div>

            </div>
        }

    </form>

</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}