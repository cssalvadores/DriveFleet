@model DriveFleet.Web.Models.Reservations.ReservationViewModel

@using System.Globalization

@{
    ViewData["Title"] =
        $"Reservation #{Model.ReservationId}";

    var canManageAllReservations =
        User.IsInRole("Admin") ||
        User.IsInRole("Employee");

    var statusClass =
        Model.ReservationStatusName
            .Trim()
            .ToLowerInvariant();

    var englishCulture =
        CultureInfo.GetCultureInfo("en-GB");

    var portugueseCulture =
        CultureInfo.GetCultureInfo("pt-PT");
}

<link rel="stylesheet"
      href="~/css/reservations.css"
      asp-append-version="true" />

<section class="reservation-details-page">

    <!-- Back navigation -->
    <div class="reservation-details-back">

        <a asp-controller="Reservations"
           asp-action="Index"
           class="reservation-details-back__link">

            <span aria-hidden="true">
                ←
            </span>

            <span>
                Back to reservations
            </span>

        </a>

    </div>

    <!-- Hero -->
    <header class="reservation-details-hero">

        <div class="reservation-details-hero__top">

            <div>

                <span class="reservation-details-eyebrow">
                    RENTAL OPERATION
                </span>

                <div class="reservation-details-title-row">

                    <h1>
                        Reservation #@Model.ReservationId
                    </h1>

                    <span class="reservation-status reservation-status--@statusClass">
                        @Model.ReservationStatusName
                    </span>

                </div>

                <p>
                    Complete rental information, vehicles and operational workflow.
                </p>

            </div>

            <div class="reservation-details-hero__total">

                <span>
                    Reservation total
                </span>

                <strong>
                    @Model.TotalValue.ToString(
                        "C2",
                        portugueseCulture)
                </strong>

            </div>

        </div>

        <div class="reservation-details-hero__meta">

            <div class="reservation-details-hero__meta-item">

                <span>
                    CREATED
                </span>

                <strong>
                    @(Model.CreatedAt
                        .ToLocalTime()
                        .ToString(
                            "dd MMM yyyy",
                            englishCulture))
                </strong>

                <small>
                    @(Model.CreatedAt
                        .ToLocalTime()
                        .ToString(
                            "HH:mm",
                            CultureInfo.InvariantCulture))
                </small>

            </div>

            <div class="reservation-details-hero__meta-item">

                <span>
                    VEHICLES
                </span>

                <strong>
                    @Model.Vehicles.Count
                </strong>

                <small>
                    @(Model.Vehicles.Count == 1
                        ? "vehicle"
                        : "vehicles")
                </small>

            </div>

            <div class="reservation-details-hero__meta-item">

                <span>
                    STATUS
                </span>

                <strong>
                    @Model.ReservationStatusName
                </strong>

                <small>
                    Current workflow state
                </small>

            </div>

            @if (Model.UpdatedAt.HasValue)
            {
                <div class="reservation-details-hero__meta-item">

                    <span>
                        LAST UPDATED
                    </span>

                    <strong>
                        @(Model.UpdatedAt.Value
                            .ToLocalTime()
                            .ToString(
                                "dd MMM yyyy",
                                englishCulture))
                    </strong>

                    <small>
                        @(Model.UpdatedAt.Value
                            .ToLocalTime()
                            .ToString(
                                "HH:mm",
                                CultureInfo.InvariantCulture))
                    </small>

                </div>
            }

        </div>

    </header>

    <!-- Feedback -->
    @if (TempData["ReservationSuccess"] is string successMessage)
    {
        <div class="reservation-feedback reservation-feedback--success"
             role="alert">

            <span class="reservation-feedback__icon">
                ✓
            </span>

            <span>
                @successMessage
            </span>

        </div>
    }

    @if (TempData["ReservationError"] is string errorMessage)
    {
        <div class="reservation-feedback reservation-feedback--error"
             role="alert">

            <span class="reservation-feedback__icon">
                !
            </span>

            <span>
                @errorMessage
            </span>

        </div>
    }

    <!-- Main information -->
    <div class="reservation-details-grid">

        <section class="reservation-details-panel">

            <div class="reservation-details-panel__heading">

                <div>

                    <span class="reservation-details-panel__eyebrow">
                        RESERVATION
                    </span>

                    <h2>
                        Reservation information
                    </h2>

                </div>

            </div>

            <div class="reservation-info-grid">

                <div class="reservation-info-item">

                    <span>
                        Reservation ID
                    </span>

                    <strong>
                        #@Model.ReservationId
                    </strong>

                </div>

                <div class="reservation-info-item">

                    <span>
                        Status
                    </span>

                    <strong>
                        @Model.ReservationStatusName
                    </strong>

                </div>

                <div class="reservation-info-item">

                    <span>
                        Created
                    </span>

                    <strong>
                        @(Model.CreatedAt
                            .ToLocalTime()
                            .ToString(
                                "dd MMM yyyy HH:mm",
                                englishCulture))
                    </strong>

                </div>

                @if (Model.UpdatedAt.HasValue)
                {
                    <div class="reservation-info-item">

                        <span>
                            Last updated
                        </span>

                        <strong>
                            @(Model.UpdatedAt.Value
                                .ToLocalTime()
                                .ToString(
                                    "dd MMM yyyy HH:mm",
                                    englishCulture))
                        </strong>

                    </div>
                }

            </div>

        </section>

        @if (canManageAllReservations)
        {
            <section class="reservation-details-panel">

                <div class="reservation-details-panel__heading">

                    <div>

                        <span class="reservation-details-panel__eyebrow">
                            CUSTOMER
                        </span>

                        <h2>
                            Customer information
                        </h2>

                    </div>

                    <div class="reservation-customer-avatar"
                         aria-hidden="true">

                        @(string.IsNullOrWhiteSpace(Model.UserFullName)
                            ? "C"
                            : Model.UserFullName
                                .Trim()
                                .Substring(0, 1)
                                .ToUpperInvariant())

                    </div>

                </div>

                <div class="reservation-customer">

                    <strong>
                        @Model.UserFullName
                    </strong>

                    <span>
                        @Model.UserEmail
                    </span>

                </div>

            </section>
        }

    </div>

    <!-- Vehicles -->
    <section class="reservation-vehicles-section">

        <div class="reservation-details-section-title">

            <div>

                <span>
                    RENTAL ITEMS
                </span>

                <h2>
                    Vehicles
                </h2>

            </div>

            <div class="reservation-details-section-count">
                @Model.Vehicles.Count
                @(Model.Vehicles.Count == 1
                    ? "vehicle"
                    : "vehicles")
            </div>

        </div>

        <div class="reservation-vehicle-list">

            @foreach (var vehicle in Model.Vehicles)
            {
                <article class="reservation-vehicle-card">

                    <div class="reservation-vehicle-card__header">

                        <div>

                            <span class="reservation-vehicle-card__eyebrow">
                                RESERVED VEHICLE
                            </span>

                            <h3>
                                @vehicle.VehicleBrand
                                @vehicle.VehicleModel
                            </h3>

                            <span class="reservation-vehicle-card__plate">
                                @vehicle.LicensePlate
                            </span>

                        </div>

                        <a asp-controller="Vehicles"
                           asp-action="Details"
                           asp-route-vehicleId="@vehicle.VehicleId"
                           class="reservation-vehicle-card__link">

                            Vehicle details

                            <span aria-hidden="true">
                                →
                            </span>

                        </a>

                    </div>

                    <div class="reservation-vehicle-card__body">

                        <!-- Rental information -->
                        <div class="reservation-vehicle-card__rental">

                            <div class="reservation-rental-period">

                                <div class="reservation-rental-period__point">

                                    <span>
                                        PICK-UP
                                    </span>

                                    <strong>
                                        @vehicle.StartDate.ToString(
                                            "dd MMM yyyy",
                                            englishCulture)
                                    </strong>

                                    <small>
                                        @vehicle.StartDate.ToString(
                                            "HH:mm",
                                            CultureInfo.InvariantCulture)
                                    </small>

                                </div>

                                <div class="reservation-rental-period__line">

                                    <span></span>

                                    <small>
                                        @vehicle.RentalDays
                                        @(vehicle.RentalDays == 1
                                            ? "day"
                                            : "days")
                                    </small>

                                    <span></span>

                                </div>

                                <div class="reservation-rental-period__point reservation-rental-period__point--end">

                                    <span>
                                        RETURN
                                    </span>

                                    <strong>
                                        @vehicle.EndDate.ToString(
                                            "dd MMM yyyy",
                                            englishCulture)
                                    </strong>

                                    <small>
                                        @vehicle.EndDate.ToString(
                                            "HH:mm",
                                            CultureInfo.InvariantCulture)
                                    </small>

                                </div>

                            </div>

                            <div class="reservation-vehicle-metrics">

                                <div>

                                    <span>
                                        DAILY RATE
                                    </span>

                                    <strong>
                                        @vehicle.DailyPrice.ToString(
                                            "C2",
                                            portugueseCulture)
                                    </strong>

                                </div>

                                <div>

                                    <span>
                                        RENTAL
                                    </span>

                                    <strong>
                                        @vehicle.RentalValue.ToString(
                                            "C2",
                                            portugueseCulture)
                                    </strong>

                                </div>

                                <div>

                                    <span>
                                        EXTRAS
                                    </span>

                                    <strong>
                                        @vehicle.ExtrasValue.ToString(
                                            "C2",
                                            portugueseCulture)
                                    </strong>

                                </div>

                            </div>

                        </div>

                        <!-- Extras -->
                        <aside class="reservation-extras">

                            <div class="reservation-extras__heading">

                                <span>
                                    EXTRAS
                                </span>

                                <strong>
                                    @vehicle.ExtrasValue.ToString(
                                        "C2",
                                        portugueseCulture)
                                </strong>

                            </div>

                            @if (vehicle.Extras.Count == 0)
                            {
                                <div class="reservation-extras__empty">

                                    <span class="reservation-extras__empty-icon">
                                        —
                                    </span>

                                    <span>
                                        No extras selected
                                    </span>

                                </div>
                            }
                            else
                            {
                                <div class="reservation-extras__list">

                                    @foreach (var extra in vehicle.Extras)
                                    {
                                        <div class="reservation-extra-item">

                                            <div>

                                                <strong>
                                                    @extra.Name
                                                </strong>

                                                <span>
                                                    Quantity @extra.Quantity
                                                </span>

                                            </div>

                                            <strong>
                                                @extra.Total.ToString(
                                                    "C2",
                                                    portugueseCulture)
                                            </strong>

                                        </div>
                                    }

                                </div>
                            }

                            <div class="reservation-extras__total">

                                <span>
                                    Vehicle total
                                </span>

                                <strong>
                                    @vehicle.TotalValue.ToString(
                                        "C2",
                                        portugueseCulture)
                                </strong>

                            </div>

                        </aside>

                    </div>

                </article>
            }

        </div>

    </section>

    <!-- Workflow -->
    <section class="reservation-workflow">

        <div class="reservation-workflow__summary">

            <span class="reservation-details-panel__eyebrow">
                TOTAL
            </span>

            <h2>
                Reservation total
            </h2>

            <strong class="reservation-workflow__total">
                @Model.TotalValue.ToString(
                    "C2",
                    portugueseCulture)
            </strong>

            <p>
                Total value calculated from all vehicles and selected extras.
            </p>

        </div>

        <div class="reservation-workflow__actions">

            @if (canManageAllReservations &&
                 Model.CanStart)
            {
                <form asp-controller="Reservations"
                      asp-action="Start"
                      asp-route-reservationId="@Model.ReservationId"
                      method="post"
                      onsubmit="return confirm('Start this reservation?');">

                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="reservation-action reservation-action--primary">

                        Start reservation

                        <span aria-hidden="true">
                            →
                        </span>

                    </button>

                </form>
            }

            @if (canManageAllReservations &&
                 Model.CanComplete)
            {
                <form asp-controller="Reservations"
                      asp-action="Complete"
                      asp-route-reservationId="@Model.ReservationId"
                      method="post"
                      onsubmit="return confirm('Complete this reservation?');">

                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="reservation-action reservation-action--success">

                        Complete reservation

                        <span aria-hidden="true">
                            ✓
                        </span>

                    </button>

                </form>
            }

            @if ((canManageAllReservations &&
                  Model.CanCancel) ||
                 (!canManageAllReservations &&
                  Model.CanClientCancel))
            {
                <form asp-controller="Reservations"
                      asp-action="Cancel"
                      asp-route-reservationId="@Model.ReservationId"
                      method="post"
                      onsubmit="return confirm('Are you sure you want to cancel this reservation?');">

                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="reservation-action reservation-action--danger">

                        Cancel reservation

                    </button>

                </form>
            }

            @if (!(canManageAllReservations && Model.CanStart) &&
                 !(canManageAllReservations && Model.CanComplete) &&
                 !((canManageAllReservations && Model.CanCancel) ||
                   (!canManageAllReservations && Model.CanClientCancel)))
            {
                <div class="reservation-workflow__readonly">

                    <span class="reservation-workflow__readonly-dot reservation-card__dot--@statusClass">
                    </span>

                    <span>
                        @switch (statusClass)
                        {
                            case "completed":
                                <text>
                                    This reservation has been completed.
                                </text>
                                break;

                            case "cancelled":
                                <text>
                                    This reservation has been cancelled.
                                </text>
                                break;

                            case "active":
                                <text>
                                    This reservation is currently active.
                                </text>
                                break;

                            default:
                                <text>
                                    No actions are currently available.
                                </text>
                                break;
                        }
                    </span>

                </div>
            }

        </div>

    </section>

</section>