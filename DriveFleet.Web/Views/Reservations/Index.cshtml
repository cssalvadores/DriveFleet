@model DriveFleet.Web.Models.Reservations.ReservationIndexViewModel

@using System.Globalization

@{
    var isClient =
        User.IsInRole("Client");

    var isStaff =
        User.IsInRole("Admin") ||
        User.IsInRole("Employee");

    ViewData["Title"] =
        isClient
            ? "My reservations"
            : "Reservations";

    var reservations =
        Model.Reservations
            .OrderByDescending(reservation =>
                reservation.Vehicles
                    .Select(vehicle => vehicle.StartDate)
                    .DefaultIfEmpty(reservation.CreatedAt)
                    .Min())
            .ToList();

    var pendingCount =
        reservations.Count(reservation =>
            string.Equals(
                reservation.ReservationStatusName,
                "Pending",
                StringComparison.OrdinalIgnoreCase));

    var activeCount =
        reservations.Count(reservation =>
            string.Equals(
                reservation.ReservationStatusName,
                "Active",
                StringComparison.OrdinalIgnoreCase));

    var completedCount =
        reservations.Count(reservation =>
            string.Equals(
                reservation.ReservationStatusName,
                "Completed",
                StringComparison.OrdinalIgnoreCase));

    var hasFilters =
        Model.StatusId.HasValue ||
        Model.FromDate.HasValue ||
        Model.ToDate.HasValue;
}

<link rel="stylesheet"
      href="~/css/reservations.css"
      asp-append-version="true" />

<section class="reservations-page">

    <!-- Hero -->
    <header class="reservations-hero">

        <div class="reservations-hero__content">

            <div class="reservations-eyebrow">
                @(isClient ? "YOUR RENTALS" : "FLEET OPERATIONS")
            </div>

            <div class="reservations-hero__main">

                <div>

                    <h1 class="reservations-title">
                        @(isClient ? "My reservations" : "Reservations")
                    </h1>

                    <p class="reservations-subtitle">
                        @if (isClient)
                        {
                            <text>
                                Track your bookings, rental periods and reservation history.
                            </text>
                        }
                        else
                        {
                            <text>
                                Monitor rental activity and manage the DriveFleet reservation workflow.
                            </text>
                        }
                    </p>

                </div>

                <a asp-controller="Vehicles"
                   asp-action="Index"
                   class="reservations-hero__action">

                    <span class="reservations-hero__action-icon"
                          aria-hidden="true">
                        +
                    </span>

                    <span>
                        Browse vehicles
                    </span>

                </a>

            </div>

        </div>

    </header>

    <div class="reservations-content">

        <!-- Summary -->
        <section class="reservations-summary"
                 aria-label="Reservation summary">

            <article class="reservation-stat">

                <span class="reservation-stat__label">
                    Showing
                </span>

                <strong class="reservation-stat__value">
                    @reservations.Count
                </strong>

                <span class="reservation-stat__caption">
                    @(reservations.Count == 1
                        ? "reservation"
                        : "reservations")
                </span>

            </article>

            <article class="reservation-stat">

                <span class="reservation-stat__label">
                    Pending
                </span>

                <strong class="reservation-stat__value">
                    @pendingCount
                </strong>

                <span class="reservation-stat__caption">
                    Awaiting start
                </span>

            </article>

            <article class="reservation-stat">

                <span class="reservation-stat__label">
                    Active
                </span>

                <strong class="reservation-stat__value">
                    @activeCount
                </strong>

                <span class="reservation-stat__caption">
                    In progress
                </span>

            </article>

            <article class="reservation-stat">

                <span class="reservation-stat__label">
                    Completed
                </span>

                <strong class="reservation-stat__value">
                    @completedCount
                </strong>

                <span class="reservation-stat__caption">
                    Finished rentals
                </span>

            </article>

        </section>

        <!-- Filters -->
        <section class="reservations-filter-card">

            <div class="reservations-section-heading">

                <div>

                    <span class="reservations-section-heading__eyebrow">
                        FILTERS
                    </span>

                    <h2>
                        Find reservations
                    </h2>

                </div>

                @if (hasFilters)
                {
                    <a asp-controller="Reservations"
                       asp-action="Index"
                       class="reservations-clear-link">
                        Clear filters
                    </a>
                }

            </div>

            <form asp-controller="Reservations"
                  asp-action="Index"
                  method="get"
                  class="reservations-filter-form">

                <div class="reservations-filter-field">

                    <label for="statusId">
                        Status
                    </label>

                    <select id="statusId"
                            name="statusId"
                            class="form-select">

                        <option value="">
                            All statuses
                        </option>

                        <option value="1"
                                selected="@(Model.StatusId == 1)">
                            Pending
                        </option>

                        <option value="2"
                                selected="@(Model.StatusId == 2)">
                            Active
                        </option>

                        <option value="3"
                                selected="@(Model.StatusId == 3)">
                            Completed
                        </option>

                        <option value="4"
                                selected="@(Model.StatusId == 4)">
                            Cancelled
                        </option>

                    </select>

                </div>

                <div class="reservations-filter-field">

                    <label for="fromDate">
                        From date
                    </label>

                    <input id="fromDate"
                           name="fromDate"
                           type="date"
                           class="form-control"
                           value="@Model.FromDate?.ToString("yyyy-MM-dd")" />

                </div>

                <div class="reservations-filter-field">

                    <label for="toDate">
                        To date
                    </label>

                    <input id="toDate"
                           name="toDate"
                           type="date"
                           class="form-control"
                           value="@Model.ToDate?.ToString("yyyy-MM-dd")" />

                </div>

                <div class="reservations-filter-actions">

                    <button type="submit"
                            class="reservations-filter-button">
                        Apply filters
                    </button>

                </div>

            </form>

            @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
            {
                <div class="reservations-message reservations-message--error"
                     role="alert">

                    <span aria-hidden="true">
                        !
                    </span>

                    <span>
                        @Model.ErrorMessage
                    </span>

                </div>
            }

        </section>

        <!-- Results heading -->
        <div class="reservations-results-heading">

            <div>

                <span class="reservations-section-heading__eyebrow">
                    @(isClient ? "BOOKING HISTORY" : "RESERVATION ACTIVITY")
                </span>

                <h2>
                    @(isClient ? "Your rentals" : "Rental activity")
                </h2>

            </div>

            <div class="reservations-results-count">
                @reservations.Count
                @(reservations.Count == 1
                    ? "result"
                    : "results")
            </div>

        </div>

        @if (reservations.Count == 0)
        {
            <!-- Empty state -->
            <section class="reservations-empty">

                <div class="reservations-empty__icon"
                     aria-hidden="true">
                    ✓
                </div>

                <h2>
                    No reservations found
                </h2>

                <p>
                    @if (hasFilters)
                    {
                        <text>
                            No reservations match the filters currently selected.
                        </text>
                    }
                    else if (isClient)
                    {
                        <text>
                            You do not have any reservations yet.
                        </text>
                    }
                    else
                    {
                        <text>
                            There are currently no reservations to display.
                        </text>
                    }
                </p>

                @if (hasFilters)
                {
                    <a asp-controller="Reservations"
                       asp-action="Index"
                       class="reservations-empty__button">
                        Show all reservations
                    </a>
                }
                else
                {
                    <a asp-controller="Vehicles"
                       asp-action="Index"
                       class="reservations-empty__button">
                        Browse vehicles
                    </a>
                }

            </section>
        }
        else
        {
            <!-- Reservation cards -->
            <div class="reservations-list">

                @foreach (var reservation in reservations)
                {
                    var rentalStart =
                        reservation.Vehicles
                            .Select(vehicle => vehicle.StartDate)
                            .DefaultIfEmpty(reservation.CreatedAt)
                            .Min();

                    var rentalEnd =
                        reservation.Vehicles
                            .Select(vehicle => vehicle.EndDate)
                            .DefaultIfEmpty(reservation.CreatedAt)
                            .Max();

                    var statusClass =
                        reservation.ReservationStatusName
                            .Trim()
                            .ToLowerInvariant();

                    var vehicleNames =
                        reservation.Vehicles
                            .Select(vehicle =>
                                $"{vehicle.VehicleBrand} {vehicle.VehicleModel}")
                            .ToList();

                    var vehicleSummary =
                        vehicleNames.Count == 0
                            ? "No vehicle information"
                            : string.Join(
                                ", ",
                                vehicleNames);

                    <article class="reservation-card">

                        <div class="reservation-card__header">

                            <div class="reservation-card__identity">

                                <span class="reservation-card__number">
                                    Reservation #@reservation.ReservationId
                                </span>

                                <span class="reservation-status reservation-status--@statusClass">
                                    @reservation.ReservationStatusName
                                </span>

                            </div>

                            <div class="reservation-card__price">

                                <span>
                                    Total
                                </span>

                                <strong>
                                    @reservation.TotalValue.ToString(
                                        "C2",
                                        CultureInfo.GetCultureInfo("pt-PT"))
                                </strong>

                            </div>

                        </div>

                        <div class="reservation-card__body">

                            @if (isStaff)
                            {
                                <div class="reservation-card__customer">

                                    <span class="reservation-meta-label">
                                        CUSTOMER
                                    </span>

                                    <strong>
                                        @reservation.UserFullName
                                    </strong>

                                    <span>
                                        @reservation.UserEmail
                                    </span>

                                </div>
                            }

                            <div class="reservation-card__details">

                                <div class="reservation-card__detail">

                                    <span class="reservation-meta-label">
                                        VEHICLE@(reservation.Vehicles.Count == 1 ? "" : "S")
                                    </span>

                                    <strong>
                                        @vehicleSummary
                                    </strong>

                                    <span>
                                        @reservation.Vehicles.Count
                                        @(reservation.Vehicles.Count == 1
                                            ? "vehicle"
                                            : "vehicles")
                                    </span>

                                </div>

                                <div class="reservation-card__detail">

                                    <span class="reservation-meta-label">
                                        RENTAL PERIOD
                                    </span>

                                    <strong>
                                        @rentalStart.ToString(
                                            "dd MMM yyyy",
                                            CultureInfo.GetCultureInfo("en-GB"))

                                        <span aria-hidden="true">
                                            →
                                        </span>

                                        @rentalEnd.ToString(
                                            "dd MMM yyyy",
                                            CultureInfo.GetCultureInfo("en-GB"))
                                    </strong>

                                    <span>
                                        @rentalStart.ToString("HH:mm")
                                        —
                                        @rentalEnd.ToString("HH:mm")
                                    </span>

                                </div>

                                <div class="reservation-card__detail">

                                    <span class="reservation-meta-label">
                                        CREATED
                                    </span>

                                    <strong>
                                        @(reservation.CreatedAt
                                            .ToLocalTime()
                                            .ToString(
                                                "dd MMM yyyy",
                                                CultureInfo.GetCultureInfo("en-GB")))
                                    </strong>

                                    <span>
                                        @(reservation.CreatedAt
                                            .ToLocalTime()
                                            .ToString(
                                                "HH:mm",
                                                CultureInfo.InvariantCulture))
                                    </span>

                                </div>

                            </div>

                        </div>

                        <div class="reservation-card__footer">

                            <div class="reservation-card__footer-note">

                                <span class="reservation-card__dot reservation-card__dot--@statusClass">
                                </span>

                                <span>
                                    @switch (statusClass)
                                    {
                                        case "pending":
                                            <text>
                                                Awaiting rental start
                                            </text>
                                            break;

                                        case "active":
                                            <text>
                                                Rental currently in progress
                                            </text>
                                            break;

                                        case "completed":
                                            <text>
                                                Rental completed
                                            </text>
                                            break;

                                        case "cancelled":
                                            <text>
                                                Reservation cancelled
                                            </text>
                                            break;

                                        default:
                                            <text>
                                                Reservation status
                                            </text>
                                            break;
                                    }
                                </span>

                            </div>

                            <a asp-controller="Reservations"
                               asp-action="Details"
                               asp-route-reservationId="@reservation.ReservationId"
                               class="reservation-card__details-link">

                                View reservation

                                <span aria-hidden="true">
                                    →
                                </span>

                            </a>

                        </div>

                    </article>
                }

            </div>
        }

    </div>

</section>