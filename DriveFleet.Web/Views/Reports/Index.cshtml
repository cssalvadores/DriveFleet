@{
    ViewData["Title"] = "Reports";
}

<link rel="stylesheet"
      href="~/css/reports.css"
      asp-append-version="true" />

<section class="reports-page">

    <!-- Back navigation -->
    <div class="reports-back">

        <a asp-controller="Dashboard"
           asp-action="Index"
           class="reports-back__link">

            <span aria-hidden="true">
                ←
            </span>

            <span>
                Back to dashboard
            </span>

        </a>

    </div>

    <!-- Hero -->
    <header class="reports-hero">

        <div class="reports-hero__content">

            <div>

                <span class="reports-eyebrow">
                    DRIVEFLEET BACKOFFICE
                </span>

                <h1>
                    Reports
                </h1>

                <p>
                    Generate operational documents and structured
                    exports from DriveFleet reservation and fleet data.
                </p>

            </div>

            <div class="reports-hero__status">

                <span class="reports-hero__status-dot">
                </span>

                <div>
                    <strong>
                        Export centre
                    </strong>

                    <span>
                        PDF &amp; XML
                    </span>
                </div>

            </div>

        </div>

        <div class="reports-hero__formats">

            <div>

                <span class="reports-format-icon">
                    PDF
                </span>

                <div>
                    <strong>
                        PDF documents
                    </strong>

                    <span>
                        Human-readable reports for review and presentation.
                    </span>
                </div>

            </div>

            <div>

                <span class="reports-format-icon reports-format-icon--xml">
                    XML
                </span>

                <div>
                    <strong>
                        XML exports
                    </strong>

                    <span>
                        Structured information for external-system integration.
                    </span>
                </div>

            </div>

        </div>

    </header>

    <!-- Reservation reports -->
    <section class="reports-section">

        <header class="reports-section__heading">

            <div>

                <span class="reports-section__eyebrow">
                    RESERVATION DATA
                </span>

                <h2>
                    Reservation reports
                </h2>

                <p>
                    Export reservation activity for a selected rental period.
                </p>

            </div>

            <span class="reports-section__badge">
                Date filter available
            </span>

        </header>

        <div class="reports-reservation-layout">

            <!-- Period configuration -->
            <div class="reports-filter-card">

                <div class="reports-filter-card__header">

                    <span class="reports-card-number">
                        01
                    </span>

                    <div>

                        <h3>
                            Select reporting period
                        </h3>

                        <p>
                            Leave both dates empty to export
                            all reservation records.
                        </p>

                    </div>

                </div>

                <form method="get"
                      class="reports-filter-form">

                    <div class="reports-filter-grid">

                        <div class="reports-field">

                            <label for="fromDate">
                                From date
                            </label>

                            <input id="fromDate"
                                   name="fromDate"
                                   type="date"
                                   class="form-control" />

                        </div>

                        <div class="reports-filter-arrow"
                             aria-hidden="true">
                            →
                        </div>

                        <div class="reports-field">

                            <label for="toDate">
                                To date
                            </label>

                            <input id="toDate"
                                   name="toDate"
                                   type="date"
                                   class="form-control" />

                        </div>

                    </div>

                    <div class="reports-export-actions">

                        <button type="submit"
                                formaction="/reports/reservations/pdf"
                                class="reports-export-button reports-export-button--pdf">

                            <span class="reports-export-button__type">
                                PDF
                            </span>

                            <span class="reports-export-button__content">

                                <strong>
                                    Export reservation report
                                </strong>

                                <small>
                                    Formatted printable document
                                </small>

                            </span>

                            <span class="reports-export-button__arrow"
                                  aria-hidden="true">
                                ↓
                            </span>

                        </button>

                        <button type="submit"
                                formaction="/reports/reservations/xml"
                                class="reports-export-button reports-export-button--xml">

                            <span class="reports-export-button__type">
                                XML
                            </span>

                            <span class="reports-export-button__content">

                                <strong>
                                    Export reservation data
                                </strong>

                                <small>
                                    Structured integration file
                                </small>

                            </span>

                            <span class="reports-export-button__arrow"
                                  aria-hidden="true">
                                ↓
                            </span>

                        </button>

                    </div>

                </form>

            </div>

            <!-- Reservation information -->
            <aside class="reports-info-card">

                <span class="reports-info-card__eyebrow">
                    INCLUDED DATA
                </span>

                <h3>
                    Reservation export
                </h3>

                <p>
                    The report uses the reservation information
                    already stored and calculated by DriveFleet.
                </p>

                <div class="reports-info-list">

                    <div class="reports-info-item">

                        <span>
                            ✓
                        </span>

                        <div>
                            <strong>
                                Reservation details
                            </strong>

                            <small>
                                Identifier, customer and status
                            </small>
                        </div>

                    </div>

                    <div class="reports-info-item">

                        <span>
                            ✓
                        </span>

                        <div>
                            <strong>
                                Rental periods
                            </strong>

                            <small>
                                Start and return information
                            </small>
                        </div>

                    </div>

                    <div class="reports-info-item">

                        <span>
                            ✓
                        </span>

                        <div>
                            <strong>
                                Vehicle information
                            </strong>

                            <small>
                                Reserved vehicles and associated totals
                            </small>
                        </div>

                    </div>

                    <div class="reports-info-item">

                        <span>
                            ✓
                        </span>

                        <div>
                            <strong>
                                Financial values
                            </strong>

                            <small>
                                Reservation and rental totals
                            </small>
                        </div>

                    </div>

                </div>

            </aside>

        </div>

    </section>

    <!-- Fleet reports -->
    <section class="reports-section">

        <header class="reports-section__heading">

            <div>

                <span class="reports-section__eyebrow">
                    FLEET DATA
                </span>

                <h2>
                    Vehicle inventory
                </h2>

                <p>
                    Export the complete current DriveFleet vehicle inventory.
                </p>

            </div>

            <span class="reports-section__badge">
                Full inventory
            </span>

        </header>

        <div class="reports-fleet-grid">

            <!-- Vehicle PDF -->
            <article class="reports-document-card">

                <div class="reports-document-card__top">

                    <span class="reports-document-icon reports-document-icon--pdf">
                        PDF
                    </span>

                    <span class="reports-document-card__category">
                        DOCUMENT
                    </span>

                </div>

                <h3>
                    Vehicle inventory report
                </h3>

                <p>
                    Generate a formatted PDF containing the
                    current vehicle fleet and operational information.
                </p>

                <div class="reports-document-card__meta">

                    <span>
                        Fleet inventory
                    </span>

                    <span>
                        Printable
                    </span>

                </div>

                <a href="/reports/vehicles/pdf"
                   class="reports-document-card__button">

                    <span>
                        Export PDF
                    </span>

                    <span aria-hidden="true">
                        ↓
                    </span>

                </a>

            </article>

            <!-- Vehicle XML -->
            <article class="reports-document-card">

                <div class="reports-document-card__top">

                    <span class="reports-document-icon reports-document-icon--xml">
                        XML
                    </span>

                    <span class="reports-document-card__category">
                        DATA EXPORT
                    </span>

                </div>

                <h3>
                    Vehicle inventory data
                </h3>

                <p>
                    Export the complete fleet as structured XML
                    for integration or external processing.
                </p>

                <div class="reports-document-card__meta">

                    <span>
                        Structured data
                    </span>

                    <span>
                        Integration ready
                    </span>

                </div>

                <a href="/reports/vehicles/xml"
                   class="reports-document-card__button">

                    <span>
                        Export XML
                    </span>

                    <span aria-hidden="true">
                        ↓
                    </span>

                </a>

            </article>

        </div>

    </section>

    <!-- Footer information -->
    <section class="reports-footer-card">

        <div class="reports-footer-card__icon"
             aria-hidden="true">
            i
        </div>

        <div>

            <strong>
                Administrative exports
            </strong>

            <p>
                Reports are generated from the current DriveFleet data.
                Reservation PDF and XML exports support the same
                optional date range.
            </p>

        </div>

        <a asp-controller="Dashboard"
           asp-action="Index">
            View dashboard →
        </a>

    </section>

</section>