@{
    ViewData["Title"] = "Password changed";
}

<div class="account-secondary-page">

    <div class="account-secondary-card">

        <div class="account-status-icon account-status-icon--success"
             aria-hidden="true">
            ✓
        </div>

        <div class="account-secondary-eyebrow">
            Password updated
        </div>

        <h1 class="account-secondary-title">
            Your password has been changed
        </h1>

        <p class="account-secondary-description">
            Your DriveFleet account password was updated successfully.
        </p>

        <div class="account-secondary-actions">

            <a asp-controller="Profile"
               asp-action="Index"
               class="account-secondary-button">
                Back to profile
            </a>

            <a asp-controller="Home"
               asp-action="Index"
               class="account-secondary-button account-secondary-button--outline">
                Back to home
            </a>

        </div>

    </div>

</div>