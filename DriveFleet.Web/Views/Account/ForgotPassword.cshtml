@model DriveFleet.Web.Models.Auth.ForgotPasswordViewModel

@{
    ViewData["Title"] = "Forgot password";
}

<div class="account-secondary-page">

    <div class="account-secondary-card">

        @if (TempData["PasswordResetRequested"] is string successMessage)
        {
            <div class="account-status-icon account-status-icon--success"
                 aria-hidden="true">
                ✓
            </div>

            <div class="account-secondary-eyebrow">
                Check your email
            </div>

            <h1 class="account-secondary-title">
                Reset link requested
            </h1>

            <p class="account-secondary-description">
                @successMessage
            </p>

            <p class="text-muted small mb-0">
                For security reasons, DriveFleet does not confirm
                whether an account exists for the email provided.
            </p>

            <div class="account-secondary-actions">

                <a asp-controller="Account"
                   asp-action="Login"
                   class="account-secondary-button">
                    Back to sign in
                </a>

                <a asp-controller="Home"
                   asp-action="Index"
                   class="account-secondary-button account-secondary-button--outline">
                    Back to home
                </a>

            </div>
        }
        else
        {
            <div class="account-secondary-mark"></div>

            <div class="account-secondary-eyebrow">
                Account recovery
            </div>

            <h1 class="account-secondary-title">
                Forgot your password?
            </h1>

            <p class="account-secondary-description">
                Enter the email associated with your DriveFleet account.
                If an account exists, we will send you a secure password
                reset link.
            </p>

            <form asp-controller="Account"
                  asp-action="ForgotPassword"
                  method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger small mb-3">
                </div>

                <div class="account-field">

                    <label asp-for="Email"
                           class="form-label account-form-label">
                        Email
                    </label>

                    <input asp-for="Email"
                           class="form-control account-input"
                           autocomplete="email"
                           placeholder="you@example.com" />

                    <span asp-validation-for="Email"
                          class="text-danger account-validation">
                    </span>

                </div>

                <button type="submit"
                        class="account-primary-button">
                    Send reset link
                </button>

            </form>

            <div class="account-form-footer">

                Remembered your password?

                <a asp-controller="Account"
                   asp-action="Login"
                   class="account-secondary-link">
                    Back to sign in
                </a>

            </div>
        }

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}