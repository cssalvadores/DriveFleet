@using DriveFleet.Web.Models.Auth
@model DriveFleet.Web.Models.Auth.ConfirmEmailViewModel

@{
    ViewData["Title"] = "Email Confirmation";

    var alertClass = Model.State switch
    {
        ConfirmEmailViewState.Success => "alert-success",
        ConfirmEmailViewState.AlreadyConfirmed => "alert-info",
        _ => "alert-danger"
    };

    var heading = Model.State switch
    {
        ConfirmEmailViewState.Success => "Email confirmed",
        ConfirmEmailViewState.AlreadyConfirmed => "Email already confirmed",
        _ => "Email confirmation failed"
    };
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <h1 class="h3 mb-4">@heading</h1>

                    <div class="alert @alertClass" role="alert">
                        @Model.Message
                    </div>

                    <a asp-controller="Home"
                       asp-action="Index"
                       class="btn btn-primary">
                        Return to home page
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
