@model DriveFleet.Web.Models.Auth.ConfirmEmailViewModel

@{
    ViewData["Title"] = "Email confirmation";

    var isSuccess =
        Model.State ==
        DriveFleet.Web.Models.Auth.ConfirmEmailViewState.Success;

    var isAlreadyConfirmed =
        Model.State ==
        DriveFleet.Web.Models.Auth.ConfirmEmailViewState.AlreadyConfirmed;

    var isError =
        Model.State ==
        DriveFleet.Web.Models.Auth.ConfirmEmailViewState.Error;
}

<div class="account-secondary-page">

    <div class="account-secondary-card">

        @if (isSuccess)
        {
            <div class="account-status-icon account-status-icon--success"
                 aria-hidden="true">
                ✓
            </div>

            <div class="account-secondary-eyebrow">
                Email confirmed
            </div>

            <h1 class="account-secondary-title">
                Your account is ready
            </h1>

            <p class="account-secondary-description">
                @Model.Message
            </p>

            <div class="account-secondary-actions">

                <a asp-controller="Account"
                   asp-action="Login"
                   class="account-secondary-button">
                    Sign in
                </a>

                <a asp-controller="Home"
                   asp-action="Index"
                   class="account-secondary-button account-secondary-button--outline">
                    Back to home
                </a>

            </div>
        }
        else if (isAlreadyConfirmed)
        {
            <div class="account-status-icon account-status-icon--success"
                 aria-hidden="true">
                ✓
            </div>

            <div class="account-secondary-eyebrow">
                Already confirmed
            </div>

            <h1 class="account-secondary-title">
                Your email is already confirmed
            </h1>

            <p class="account-secondary-description">
                @Model.Message
            </p>

            <div class="account-secondary-actions">

                <a asp-controller="Account"
                   asp-action="Login"
                   class="account-secondary-button">
                    Sign in
                </a>

                <a asp-controller="Home"
                   asp-action="Index"
                   class="account-secondary-button account-secondary-button--outline">
                    Back to home
                </a>

            </div>
        }
        else if (isError)
        {
            <div class="account-status-icon account-status-icon--error"
                 aria-hidden="true">
                !
            </div>

            <div class="account-secondary-eyebrow">
                Confirmation failed
            </div>

            <h1 class="account-secondary-title">
                We could not confirm your email
            </h1>

            <p class="account-secondary-description">
                @Model.Message
            </p>

            <div class="account-secondary-actions">

                <a asp-controller="Account"
                   asp-action="Register"
                   class="account-secondary-button">
                    Create account
                </a>

                <a asp-controller="Account"
                   asp-action="Login"
                   class="account-secondary-button account-secondary-button--outline">
                    Back to sign in
                </a>

            </div>
        }

    </div>

</div>