@model DriveFleet.Web.Models.Auth.ChangePasswordViewModel

@{
    ViewData["Title"] = "Change password";
}

<div class="account-secondary-page">

    <div class="account-secondary-card">

        <div class="account-secondary-mark"></div>

        <div class="account-secondary-eyebrow">
            Account security
        </div>

        <h1 class="account-secondary-title">
            Change your password
        </h1>

        <p class="account-secondary-description">
            Enter your current password and choose a new secure password
            for your DriveFleet account.
        </p>

        <form asp-controller="Account"
              asp-action="ChangePassword"
              method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="text-danger small mb-3">
            </div>

            <div class="account-field">

                <label asp-for="CurrentPassword"
                       class="form-label account-form-label">
                    Current password
                </label>

                <input asp-for="CurrentPassword"
                       class="form-control account-input"
                       autocomplete="current-password" />

                <span asp-validation-for="CurrentPassword"
                      class="text-danger account-validation">
                </span>

            </div>

            <div class="account-field">

                <label asp-for="NewPassword"
                       class="form-label account-form-label">
                    New password
                </label>

                <input asp-for="NewPassword"
                       class="form-control account-input"
                       autocomplete="new-password" />

                <span asp-validation-for="NewPassword"
                      class="text-danger account-validation">
                </span>

            </div>

            <div class="account-field">

                <label asp-for="ConfirmNewPassword"
                       class="form-label account-form-label">
                    Confirm new password
                </label>

                <input asp-for="ConfirmNewPassword"
                       class="form-control account-input"
                       autocomplete="new-password" />

                <span asp-validation-for="ConfirmNewPassword"
                      class="text-danger account-validation">
                </span>

            </div>

            <button type="submit"
                    class="account-primary-button">
                Change password
            </button>

        </form>

        <div class="account-form-footer">

            <a asp-controller="Profile"
               asp-action="Index"
               class="account-secondary-link">
                Back to profile
            </a>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}