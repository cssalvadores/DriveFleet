@model DriveFleet.Web.Models.Auth.RegisterViewModel

@{
    ViewData["Title"] = "Create account";
}

<section class="account-shell">

    <div class="account-visual">

        <div class="account-visual-content">

            <div class="account-visual-eyebrow">
                JOIN DRIVEFLEET
            </div>

            <h1 class="account-visual-title">
                Your journey
                <span>
                    starts here.
                </span>
            </h1>

            <p class="account-visual-description">
                Create your account and enjoy a simpler way
                to explore vehicles and manage your reservations.
            </p>

        </div>

    </div>

    <div class="account-form-panel">

        <div class="account-form-wrapper">

            <div class="account-form-eyebrow">
                Get started
            </div>

            <h2 class="account-form-title">
                Create account
            </h2>

            <p class="account-form-subtitle">
                Create your DriveFleet account in just a few steps.
            </p>

            <form asp-controller="Account"
                  asp-action="Register"
                  method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger small mb-3">
                </div>

                <div class="account-field-row">

                    <div class="account-field">

                        <label asp-for="FirstName"
                               class="form-label account-form-label">
                            First name
                        </label>

                        <input asp-for="FirstName"
                               class="form-control account-input"
                               autocomplete="given-name" />

                        <span asp-validation-for="FirstName"
                              class="text-danger account-validation">
                        </span>

                    </div>

                    <div class="account-field">

                        <label asp-for="LastName"
                               class="form-label account-form-label">
                            Last name
                        </label>

                        <input asp-for="LastName"
                               class="form-control account-input"
                               autocomplete="family-name" />

                        <span asp-validation-for="LastName"
                              class="text-danger account-validation">
                        </span>

                    </div>

                </div>

                <div class="account-field">

                    <label asp-for="Email"
                           class="form-label account-form-label">
                        Email
                    </label>

                    <input asp-for="Email"
                           class="form-control account-input"
                           autocomplete="email" />

                    <span asp-validation-for="Email"
                          class="text-danger account-validation">
                    </span>

                </div>

                <div class="account-field">

                    <label asp-for="Phone"
                           class="form-label account-form-label">
                        Phone
                    </label>

                    <input asp-for="Phone"
                           class="form-control account-input"
                           autocomplete="tel" />

                    <span asp-validation-for="Phone"
                          class="text-danger account-validation">
                    </span>

                </div>

                <div class="account-field-row">

                    <div class="account-field">

                        <label asp-for="Password"
                               class="form-label account-form-label">
                            Password
                        </label>

                        <input asp-for="Password"
                               class="form-control account-input"
                               autocomplete="new-password" />

                        <span asp-validation-for="Password"
                              class="text-danger account-validation">
                        </span>

                    </div>

                    <div class="account-field">

                        <label asp-for="ConfirmPassword"
                               class="form-label account-form-label">
                            Confirm password
                        </label>

                        <input asp-for="ConfirmPassword"
                               class="form-control account-input"
                               autocomplete="new-password" />

                        <span asp-validation-for="ConfirmPassword"
                              class="text-danger account-validation">
                        </span>

                    </div>

                </div>

                <button type="submit"
                        class="account-primary-button">
                    Create account
                </button>

            </form>

            <div class="account-form-footer">

                Already have an account?

                <a asp-controller="Account"
                   asp-action="Login"
                   class="account-secondary-link">
                    Sign in
                </a>

            </div>

        </div>

    </div>

</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}