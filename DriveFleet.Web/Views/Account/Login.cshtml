@model DriveFleet.Web.Models.Auth.LoginViewModel

@{
    ViewData["Title"] = "Sign in";
}

<section class="account-shell">

    <div class="account-visual">

        <div class="account-visual-content">

            <div class="account-visual-eyebrow">
                DRIVEFLEET
            </div>

            <h1 class="account-visual-title">
                Freedom
                <span>
                    starts here.
                </span>
            </h1>

            <p class="account-visual-description">
                Sign in and manage your reservations,
                vehicles and journeys from one place.
            </p>

        </div>

    </div>

    <div class="account-form-panel">

        <div class="account-form-wrapper">

            <div class="account-form-eyebrow">
                Welcome back
            </div>

            <h2 class="account-form-title">
                Sign in
            </h2>

            <p class="account-form-subtitle">
                Sign in to your DriveFleet account.
            </p>

            @if (TempData["RegistrationSuccess"] is string successMessage)
            {
                <div class="alert alert-success account-alert"
                     role="alert">
                    @successMessage
                </div>
            }

            <form asp-controller="Account"
                  asp-action="Login"
                  method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger small mb-3">
                </div>

                <div class="account-field">

                    <label asp-for="Email"
                           class="form-label account-form-label">
                        Email
                    </label>

                    <input asp-for="Email"
                           class="form-control account-input"
                           autocomplete="email" />

                    <span asp-validation-for="Email"
                          class="text-danger account-validation">
                    </span>

                </div>

                <div class="account-field">

                    <label asp-for="Password"
                           class="form-label account-form-label">
                        Password
                    </label>

                    <input asp-for="Password"
                           class="form-control account-input"
                           autocomplete="current-password" />

                    <span asp-validation-for="Password"
                          class="text-danger account-validation">
                    </span>

                </div>

                <div class="account-options">

                    <div class="form-check">

                        <input asp-for="RememberMe"
                               class="form-check-input" />

                        <label asp-for="RememberMe"
                               class="form-check-label account-checkbox-label">
                            Remember me
                        </label>

                    </div>

                    <a asp-controller="Account"
                       asp-action="ForgotPassword">
                        Forgot password?
                    </a>

                </div>

                <button type="submit"
                        class="account-primary-button">
                    Sign in
                </button>

            </form>

            <div class="account-form-footer">

                New to DriveFleet?

                <a asp-controller="Account"
                   asp-action="Register"
                   class="account-secondary-link">
                    Create an account
                </a>

            </div>

        </div>

    </div>

</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}