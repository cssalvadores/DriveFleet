@model DriveFleet.Web.Models.Profile.ProfilePhotoViewModel

@{
    ViewData["Title"] = "Profile photo";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <div class="card shadow-sm">
                <div class="card-body p-4">

                    <h2 class="mb-3">
                        Profile photo
                    </h2>

                    <p class="text-muted mb-4">
                        Upload a new photo for your DriveFleet profile.
                    </p>

                    @if (!string.IsNullOrWhiteSpace(Model.CurrentPhoto))
                    {
                        <div class="mb-4 text-center">
                            <p class="mb-2">
                                Current photo
                            </p>

                            <img src="@($"https://localhost:7094{Model.CurrentPhoto}")"
                                 alt="Current profile photo"
                                 class="img-thumbnail"
                                 style="max-width: 220px; max-height: 220px;" />
                        </div>
                    }

                    <form asp-controller="Profile"
                          asp-action="Photo"
                          method="post"
                          enctype="multipart/form-data">

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>

                        <div class="mb-4">
                            <label asp-for="Photo"
                                   class="form-label">
                            </label>

                            <input asp-for="Photo"
                                   class="form-control"
                                   accept=".jpg,.jpeg,.png,image/jpeg,image/png" />

                            <span asp-validation-for="Photo"
                                  class="text-danger">
                            </span>

                            <div class="form-text">
                                JPG, JPEG or PNG. Maximum size: 5 MB.
                            </div>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit"
                                    class="btn btn-primary">
                                Upload photo
                            </button>

                            <a asp-controller="Profile"
                               asp-action="Index"
                               class="btn btn-outline-secondary">
                                Cancel
                            </a>
                        </div>

                    </form>

                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}
