@model DriveFleet.Web.Models.Profile.UserProfileViewModel

@{
    ViewData["Title"] = "My profile";

    var displayName =
        string.Join(
            " ",
            new[]
            {
                Model.FirstName,
                Model.LastName
            }
            .Where(value =>
                !string.IsNullOrWhiteSpace(value)));

    var profileInitial =
        string.IsNullOrWhiteSpace(Model.FirstName)
            ? "U"
            : Model.FirstName
                .Trim()
                .Substring(0, 1)
                .ToUpperInvariant();

    var authenticationMethod =
        string.IsNullOrWhiteSpace(Model.Provider)
            ? "Email and password"
            : Model.Provider;

    var profilePhotoUrl =
        string.IsNullOrWhiteSpace(Model.Photo)
            ? null
            : $"https://localhost:7094{Model.Photo}";
}

<link rel="stylesheet"
      href="~/css/profile.css"
      asp-append-version="true" />

<section class="profile-page">

    <!-- Hero -->
    <header class="profile-hero">

        <div class="profile-hero__content">

            <div class="profile-hero__identity">

                <div class="profile-avatar">

                    @if (!string.IsNullOrWhiteSpace(profilePhotoUrl))
                    {
                        <img src="@profilePhotoUrl"
                             alt="@displayName profile photo" />
                    }
                    else
                    {
                        <span>
                            @profileInitial
                        </span>
                    }

                </div>

                <div>

                    <span class="profile-eyebrow">
                        DRIVEFLEET ACCOUNT
                    </span>

                    <h1>
                        @displayName
                    </h1>

                    <div class="profile-hero__meta">

                        <span class="profile-role-badge">
                            @Model.Role
                        </span>

                        @if (Model.EmailConfirmed)
                        {
                            <span class="profile-verified">

                                <span aria-hidden="true">
                                    ✓
                                </span>

                                Email verified

                            </span>
                        }
                        else
                        {
                            <span class="profile-unverified">

                                <span aria-hidden="true">
                                    !
                                </span>

                                Email not verified

                            </span>
                        }

                    </div>

                </div>

            </div>

            <div class="profile-hero__actions">

                <a asp-controller="Profile"
                   asp-action="Photo"
                   class="profile-hero__button profile-hero__button--secondary">

                    Change photo

                </a>

                <a asp-controller="Profile"
                   asp-action="Edit"
                   class="profile-hero__button profile-hero__button--primary">

                    Edit profile

                    <span aria-hidden="true">
                        →
                    </span>

                </a>

            </div>

        </div>

        <div class="profile-hero__footer">

            <div>

                <span class="profile-hero__status-dot">
                </span>

                <span>
                    Authenticated account
                </span>

            </div>

            <span>
                User #@Model.UserId
            </span>

        </div>

    </header>

    <!-- Quick overview -->
    <section class="profile-overview">

        <article class="profile-overview-card">

            <span class="profile-overview-card__label">
                ACCOUNT ROLE
            </span>

            <strong>
                @Model.Role
            </strong>

            <p>
                Current DriveFleet access level.
            </p>

        </article>

        <article class="profile-overview-card">

            <span class="profile-overview-card__label">
                EMAIL STATUS
            </span>

            <strong>
                @(Model.EmailConfirmed
                    ? "Verified"
                    : "Pending")
            </strong>

            <p>
                Status of your registered email address.
            </p>

        </article>

        <article class="profile-overview-card">

            <span class="profile-overview-card__label">
                SIGN-IN METHOD
            </span>

            <strong>
                @authenticationMethod
            </strong>

            <p>
                Authentication method linked to this account.
            </p>

        </article>

    </section>

    <div class="profile-layout">

        <!-- Personal information -->
        <main class="profile-main">

            <section class="profile-card">

                <header class="profile-card__header">

                    <div>

                        <span class="profile-card__eyebrow">
                            PERSONAL INFORMATION
                        </span>

                        <h2>
                            Profile details
                        </h2>

                        <p>
                            The personal information associated
                            with your DriveFleet account.
                        </p>

                    </div>

                    <a asp-controller="Profile"
                       asp-action="Edit">

                        Edit →

                    </a>

                </header>

                <dl class="profile-details">

                    <div>

                        <dt>
                            First name
                        </dt>

                        <dd>
                            @Model.FirstName
                        </dd>

                    </div>

                    <div>

                        <dt>
                            Last name
                        </dt>

                        <dd class="@(string.IsNullOrWhiteSpace(Model.LastName)
                                                        ? "profile-details__empty"
                                                        : null)">

                            @(string.IsNullOrWhiteSpace(Model.LastName)
                                ? "Not provided"
                                : Model.LastName)

                        </dd>

                    </div>

                    <div>

                        <dt>
                            Email address
                        </dt>

                        <dd>
                            @Model.Email
                        </dd>

                    </div>

                    <div>

                        <dt>
                            Phone number
                        </dt>

                        <dd class="@(string.IsNullOrWhiteSpace(Model.Phone)
                                                        ? "profile-details__empty"
                                                        : null)">

                            @(string.IsNullOrWhiteSpace(Model.Phone)
                                ? "Not provided"
                                : Model.Phone)

                        </dd>

                    </div>

                </dl>

            </section>

            <!-- Account -->
            <section class="profile-card">

                <header class="profile-card__header">

                    <div>

                        <span class="profile-card__eyebrow">
                            ACCOUNT ACCESS
                        </span>

                        <h2>
                            Account information
                        </h2>

                        <p>
                            Authentication and authorization
                            details for your DriveFleet account.
                        </p>

                    </div>

                </header>

                <div class="profile-account-grid">

                    <div class="profile-account-item">

                        <span class="profile-account-item__icon">
                            #
                        </span>

                        <div>

                            <span>
                                User ID
                            </span>

                            <strong>
                                @Model.UserId
                            </strong>

                        </div>

                    </div>

                    <div class="profile-account-item">

                        <span class="profile-account-item__icon">
                            R
                        </span>

                        <div>

                            <span>
                                Role
                            </span>

                            <strong>
                                @Model.Role
                            </strong>

                        </div>

                    </div>

                    <div class="profile-account-item">

                        <span class="profile-account-item__icon">
                            @@
                        </span>

                        <div>

                            <span>
                                Authentication
                            </span>

                            <strong>
                                @authenticationMethod
                            </strong>

                        </div>

                    </div>

                    <div class="profile-account-item">

                        <span class="profile-account-item__icon">
                            ✓
                        </span>

                        <div>

                            <span>
                                Email confirmation
                            </span>

                            <strong>
                                @(Model.EmailConfirmed
                                    ? "Confirmed"
                                    : "Not confirmed")
                            </strong>

                        </div>

                    </div>

                </div>

            </section>

        </main>

        <!-- Sidebar -->
        <aside class="profile-sidebar">

            <section class="profile-sidebar-card">

                <span class="profile-sidebar-card__eyebrow">
                    PROFILE PHOTO
                </span>

                <div class="profile-sidebar-photo">

                    @if (!string.IsNullOrWhiteSpace(profilePhotoUrl))
                    {
                        <img src="@profilePhotoUrl"
                             alt="@displayName profile photo" />
                    }
                    else
                    {
                        <span>
                            @profileInitial
                        </span>
                    }

                </div>

                <h2>
                    Your profile image
                </h2>

                <p>
                    Keep your account recognisable
                    with an up-to-date profile photo.
                </p>

                <a asp-controller="Profile"
                   asp-action="Photo">

                    Change profile photo

                    <span aria-hidden="true">
                        →
                    </span>

                </a>

            </section>

            <section class="profile-sidebar-card profile-sidebar-card--security">

                <span class="profile-sidebar-security-icon"
                      aria-hidden="true">
                    ✓
                </span>

                <div>

                    <strong>
                        Secure account
                    </strong>

                    <p>
                        Your profile is available only
                        while you are authenticated.
                    </p>

                </div>

            </section>

        </aside>

    </div>

</section>