@model DriveFleet.Web.Models.Profile.EditProfileViewModel

@{
    ViewData["Title"] = "Edit profile";
}

<link rel="stylesheet"
      href="~/css/profile.css"
      asp-append-version="true" />

<section class="profile-page">

    <div class="profile-back">

        <a asp-controller="Profile"
           asp-action="Index">

            <span aria-hidden="true">
                ←
            </span>

            Back to profile

        </a>

    </div>

    <header class="profile-editor-hero">

        <span class="profile-eyebrow">
            ACCOUNT SETTINGS
        </span>

        <h1>
            Edit profile
        </h1>

        <p>
            Update the personal information
            associated with your DriveFleet account.
        </p>

    </header>

    <form asp-controller="Profile"
          asp-action="Edit"
          method="post"
          asp-antiforgery="true">

        <div asp-validation-summary="ModelOnly"
             class="profile-validation"
             role="alert">
        </div>

        <div class="profile-editor-layout">

            <main class="profile-editor-main">

                <section class="profile-form-card">

                    <header class="profile-form-card__header">

                        <span class="profile-form-card__number">
                            01
                        </span>

                        <div>

                            <span>
                                PERSONAL INFORMATION
                            </span>

                            <h2>
                                Basic details
                            </h2>

                            <p>
                                Update your name and
                                contact information.
                            </p>

                        </div>

                    </header>

                    <div class="profile-form-grid">

                        <div class="profile-form-field">

                            <label asp-for="FirstName">
                            </label>

                            <input asp-for="FirstName"
                                   class="form-control"
                                   autocomplete="given-name"
                                   placeholder="First name" />

                            <span asp-validation-for="FirstName"
                                  class="profile-form-error">
                            </span>

                        </div>

                        <div class="profile-form-field">

                            <label asp-for="LastName">
                            </label>

                            <input asp-for="LastName"
                                   class="form-control"
                                   autocomplete="family-name"
                                   placeholder="Last name" />

                            <span asp-validation-for="LastName"
                                  class="profile-form-error">
                            </span>

                        </div>

                    </div>

                    <div class="profile-form-field profile-form-field--full">

                        <label asp-for="Phone">
                        </label>

                        <input asp-for="Phone"
                               class="form-control"
                               autocomplete="tel"
                               placeholder="+351 ..." />

                        <span asp-validation-for="Phone"
                              class="profile-form-error">
                        </span>

                    </div>

                </section>

            </main>

            <aside class="profile-editor-sidebar">

                <section class="profile-editor-summary">

                    <span class="profile-editor-summary__eyebrow">
                        PROFILE UPDATE
                    </span>

                    <h2>
                        Save your changes
                    </h2>

                    <p>
                        Your email address, account role and
                        authentication method are not changed
                        by this form.
                    </p>

                    <div class="profile-editor-summary__divider">
                    </div>

                    <div class="profile-editor-summary__item">

                        <span>
                            ✓
                        </span>

                        <div>

                            <strong>
                                First name
                            </strong>

                            <small>
                                Required
                            </small>

                        </div>

                    </div>

                    <div class="profile-editor-summary__item">

                        <span>
                            ✓
                        </span>

                        <div>

                            <strong>
                                Last name
                            </strong>

                            <small>
                                Optional
                            </small>

                        </div>

                    </div>

                    <div class="profile-editor-summary__item">

                        <span>
                            ✓
                        </span>

                        <div>

                            <strong>
                                Phone number
                            </strong>

                            <small>
                                Optional
                            </small>

                        </div>

                    </div>

                    <div class="profile-editor-actions">

                        <button type="submit"
                                class="profile-primary-action">

                            Save changes

                            <span aria-hidden="true">
                                →
                            </span>

                        </button>

                        <a asp-controller="Profile"
                           asp-action="Index"
                           class="profile-secondary-action">

                            Cancel

                        </a>

                    </div>

                </section>

            </aside>

        </div>

    </form>

</section>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}