@model DriveFleet.Web.Models.Profile.EditProfileViewModel

@{
    ViewData["Title"] = "Edit profile";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <div class="card shadow-sm">
                <div class="card-body p-4">

                    <h2 class="mb-3">
                        Edit profile
                    </h2>

                    <p class="text-muted mb-4">
                        Update your personal information below.
                    </p>

                    <form asp-controller="Profile"
                          asp-action="Edit"
                          method="post">

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>

                        <div class="mb-3">
                            <label asp-for="FirstName"
                                   class="form-label">
                            </label>

                            <input asp-for="FirstName"
                                   class="form-control"
                                   autocomplete="given-name" />

                            <span asp-validation-for="FirstName"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="LastName"
                                   class="form-label">
                            </label>

                            <input asp-for="LastName"
                                   class="form-control"
                                   autocomplete="family-name" />

                            <span asp-validation-for="LastName"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Phone"
                                   class="form-label">
                            </label>

                            <input asp-for="Phone"
                                   class="form-control"
                                   autocomplete="tel" />

                            <span asp-validation-for="Phone"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit"
                                    class="btn btn-primary">
                                Save changes
                            </button>

                            <a asp-controller="Profile"
                               asp-action="Index"
                               class="btn btn-outline-secondary">
                                Cancel
                            </a>
                        </div>

                    </form>

                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}
