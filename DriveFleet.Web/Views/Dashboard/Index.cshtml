@model DriveFleet.Web.Models.Dashboard.DashboardViewModel

@using System.Globalization

@{
    ViewData["Title"] = "Dashboard";

    var portugueseCulture =
        CultureInfo.GetCultureInfo("pt-PT");

    var englishCulture =
        CultureInfo.GetCultureInfo("en-GB");

    var maximumMonthlyReservations =
        Model.ReservationsByMonth.Count == 0
            ? 0
            : Model.ReservationsByMonth
                .Max(item => item.ReservationCount);

    var maximumVehicleRentals =
        Model.MostRentedVehicles.Count == 0
            ? 0
            : Model.MostRentedVehicles
                .Max(item => item.RentalCount);

    var occupancyWidth =
        Model.FleetOccupancyRate
            .ToString(
                "0.##",
                CultureInfo.InvariantCulture);
}

<link rel="stylesheet"
      href="~/css/dashboard.css"
      asp-append-version="true" />

<section class="admin-dashboard">

    <!-- Hero -->
    <header class="dashboard-hero">

        <div class="dashboard-hero__content">

            <div>

                <span class="dashboard-eyebrow">
                    DRIVEFLEET BACKOFFICE
                </span>

                <h1>
                    Dashboard
                </h1>

                <p>
                    Monitor reservations, revenue and fleet
                    performance from one operational workspace.
                </p>

            </div>

            <a asp-controller="Reports"
               asp-action="Index"
               class="dashboard-hero__action">

                <span class="dashboard-hero__action-icon"
                      aria-hidden="true">
                    ↗
                </span>

                <span>
                    Open reports
                </span>

            </a>

        </div>

        <div class="dashboard-hero__period">

            <div>

                <span>
                    CURRENT ANALYSIS PERIOD
                </span>

                <strong>
                    @Model.FromDate.ToString(
                        "dd MMM yyyy",
                        englishCulture)
                    →
                    @Model.ToDate.ToString(
                        "dd MMM yyyy",
                        englishCulture)
                </strong>

            </div>

            <div class="dashboard-hero__period-status">

                <span class="dashboard-live-dot">
                </span>

                <span>
                    Live operational data
                </span>

            </div>

        </div>

    </header>

    <!-- Period filter -->
    <section class="dashboard-filter">

        <div class="dashboard-filter__heading">

            <div>

                <span>
                    DATE RANGE
                </span>

                <h2>
                    Performance period
                </h2>

            </div>

            <p>
                Adjust the period used by the dashboard statistics.
            </p>

        </div>

        <form asp-controller="Dashboard"
              asp-action="Index"
              method="get"
              class="dashboard-filter__form">

            <div class="dashboard-filter__field">

                <label for="fromDate">
                    From date
                </label>

                <input id="fromDate"
                       name="fromDate"
                       type="date"
                       class="form-control"
                       value="@Model.FromDate.ToString("yyyy-MM-dd")" />

            </div>

            <div class="dashboard-filter__separator"
                 aria-hidden="true">
                →
            </div>

            <div class="dashboard-filter__field">

                <label for="toDate">
                    To date
                </label>

                <input id="toDate"
                       name="toDate"
                       type="date"
                       class="form-control"
                       value="@Model.ToDate.ToString("yyyy-MM-dd")" />

            </div>

            <button type="submit"
                    class="dashboard-filter__button">
                Apply period
            </button>

        </form>

    </section>

    <!-- KPI cards -->
    <section class="dashboard-kpis">

        <article class="dashboard-kpi">

            <div class="dashboard-kpi__top">

                <span class="dashboard-kpi__label">
                    RESERVATIONS
                </span>

                <span class="dashboard-kpi__icon"
                      aria-hidden="true">
                    R
                </span>

            </div>

            <strong class="dashboard-kpi__value">
                @Model.TotalReservations
            </strong>

            <p>
                Reservations starting within the selected period.
            </p>

            <div class="dashboard-kpi__footer">

                <span class="dashboard-kpi__indicator">
                </span>

                <span>
                    Selected period
                </span>

            </div>

        </article>

        <article class="dashboard-kpi dashboard-kpi--revenue">

            <div class="dashboard-kpi__top">

                <span class="dashboard-kpi__label">
                    REVENUE
                </span>

                <span class="dashboard-kpi__icon"
                      aria-hidden="true">
                    €
                </span>

            </div>

            <strong class="dashboard-kpi__value">
                @Model.TotalRevenue.ToString(
                    "C2",
                    portugueseCulture)
            </strong>

            <p>
                Revenue from non-cancelled reservations.
            </p>

            <div class="dashboard-kpi__footer">

                <span class="dashboard-kpi__indicator">
                </span>

                <span>
                    Cancelled excluded
                </span>

            </div>

        </article>

        <article class="dashboard-kpi">

            <div class="dashboard-kpi__top">

                <span class="dashboard-kpi__label">
                    FLEET
                </span>

                <span class="dashboard-kpi__icon"
                      aria-hidden="true">
                    V
                </span>

            </div>

            <strong class="dashboard-kpi__value">
                @Model.TotalVehicles
            </strong>

            <p>
                Vehicles currently registered in DriveFleet.
            </p>

            <div class="dashboard-kpi__footer">

                <span class="dashboard-kpi__indicator">
                </span>

                <span>
                    Total fleet
                </span>

            </div>

        </article>

        <article class="dashboard-kpi dashboard-kpi--occupancy">

            <div class="dashboard-kpi__top">

                <span class="dashboard-kpi__label">
                    FLEET OCCUPANCY
                </span>

                <span class="dashboard-kpi__icon"
                      aria-hidden="true">
                    %
                </span>

            </div>

            <strong class="dashboard-kpi__value">
                @Model.FleetOccupancyRate.ToString(
                    "0.##",
                    CultureInfo.InvariantCulture)%
            </strong>

            <p>
                Rental time used across the available fleet capacity.
            </p>

            <div class="dashboard-occupancy">

                <div class="dashboard-occupancy__track">

                    <span class="dashboard-occupancy__fill"
                          style="width: @occupancyWidth%;">
                    </span>

                </div>

                <span>
                    @Model.FleetOccupancyRate.ToString(
                        "0.##",
                        CultureInfo.InvariantCulture)%
                </span>

            </div>

        </article>

    </section>

    <!-- Analytics -->
    <section class="dashboard-analytics">

        <!-- Reservations by month -->
        <article class="dashboard-panel">

            <header class="dashboard-panel__header">

                <div>

                    <span class="dashboard-panel__eyebrow">
                        RESERVATION ACTIVITY
                    </span>

                    <h2>
                        Reservations by month
                    </h2>

                    <p>
                        Rental demand across the selected period.
                    </p>

                </div>

                <div class="dashboard-panel__metric">
                    @Model.TotalReservations total
                </div>

            </header>

            @if (Model.ReservationsByMonth.Count == 0)
            {
                <div class="dashboard-empty">

                    <span>
                        —
                    </span>

                    <strong>
                        No reservation activity
                    </strong>

                    <p>
                        There are no reservations for this period.
                    </p>

                </div>
            }
            else
            {
                <div class="dashboard-chart">

                    @foreach (var item in Model.ReservationsByMonth)
                    {
                        var barWidth =
                            maximumMonthlyReservations <= 0
                                ? 0m
                                : (decimal)item.ReservationCount /
                                  maximumMonthlyReservations *
                                  100m;

                        <div class="dashboard-chart__row">

                            <div class="dashboard-chart__label">
                                @item.Month
                            </div>

                            <div class="dashboard-chart__track">

                                <span class="dashboard-chart__bar"
                                      style="width: @(barWidth.ToString(
                                                                              "0.##",
                                                                              CultureInfo.InvariantCulture))%;">
                                </span>

                            </div>

                            <strong class="dashboard-chart__value">
                                @item.ReservationCount
                            </strong>

                        </div>
                    }

                </div>
            }

        </article>

        <!-- Most rented -->
        <article class="dashboard-panel">

            <header class="dashboard-panel__header">

                <div>

                    <span class="dashboard-panel__eyebrow">
                        FLEET PERFORMANCE
                    </span>

                    <h2>
                        Most rented vehicles
                    </h2>

                    <p>
                        Top vehicles by reservation frequency.
                    </p>

                </div>

                <div class="dashboard-panel__metric">
                    Top 5
                </div>

            </header>

            @if (Model.MostRentedVehicles.Count == 0)
            {
                <div class="dashboard-empty">

                    <span>
                        —
                    </span>

                    <strong>
                        No rental activity
                    </strong>

                    <p>
                        No vehicles were rented during this period.
                    </p>

                </div>
            }
            else
            {
                <div class="dashboard-ranking">

                    @{
                        var rankingPosition = 0;
                    }

                    @foreach (var vehicle in Model.MostRentedVehicles)
                    {
                        rankingPosition++;

                        var barWidth =
                            maximumVehicleRentals <= 0
                                ? 0m
                                : (decimal)vehicle.RentalCount /
                                  maximumVehicleRentals *
                                  100m;

                        <a asp-controller="Vehicles"
                           asp-action="Details"
                           asp-route-vehicleId="@vehicle.VehicleId"
                           class="dashboard-ranking__item">

                            <div class="dashboard-ranking__position">
                                @rankingPosition.ToString("00")
                            </div>

                            <div class="dashboard-ranking__vehicle">

                                <strong>
                                    @vehicle.VehicleName
                                </strong>

                                <span>
                                    @vehicle.LicensePlate
                                </span>

                                <div class="dashboard-ranking__bar">

                                    <span style="width: @(barWidth.ToString(
                                                                                "0.##",
                                                                                CultureInfo.InvariantCulture))%;">
                                    </span>

                                </div>

                            </div>

                            <div class="dashboard-ranking__count">

                                <strong>
                                    @vehicle.RentalCount
                                </strong>

                                <span>
                                    @(vehicle.RentalCount == 1
                                        ? "rental"
                                        : "rentals")
                                </span>

                            </div>

                        </a>
                    }

                </div>
            }

        </article>

    </section>

    <!-- Occupancy insight -->
    <section class="dashboard-insight">

        <div class="dashboard-insight__icon"
             aria-hidden="true">
            %
        </div>

        <div class="dashboard-insight__content">

            <span>
                FLEET UTILISATION
            </span>

            <h2>
                @Model.FleetOccupancyRate.ToString(
                    "0.##",
                    CultureInfo.InvariantCulture)%
                occupancy
            </h2>

            <p>
                Occupancy measures non-cancelled rental time
                against the total capacity of the fleet during
                the selected period.
            </p>

        </div>

        <div class="dashboard-insight__visual">

            <div class="dashboard-insight__value">
                @Model.TotalVehicles
            </div>

            <span>
                vehicles
            </span>

        </div>

    </section>

    <p class="dashboard-footnote">
        Revenue, rental frequency and fleet occupancy exclude
        cancelled reservations.
    </p>

</section>